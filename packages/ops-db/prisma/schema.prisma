/// Catalogue of Assistant action types: the 32 Autopilot rows plus
/// non-configurable system actions (fx refresh, merge, revert, import …).
model AutopilotActionDef {
  key             String          @id
  group           AutopilotGroup
  label           String
  description     String?
  ruleText        String?
  position        Int             @default(0)
  configurable    Boolean         @default(true)
  /// Set for Send quotation and Supplier POs (draft_and_ask) and Supplier payments (never).
  lockedLevel     AutopilotLevel?
  /// Highest level allowed (autonomy order off < suggest < draft_and_ask < do_and_tell < do_quietly).
  /// draft_and_ask for the priced client sends #26, #27, #31 and for regret_client, correction_email,
  /// supplier_not_chosen_notice, order_exception_email, instruction. Enforced by ops.locked_level_guard().
  maxLevel        AutopilotLevel?
  defaultCareful  AutopilotLevel
  defaultBalanced AutopilotLevel
  defaultHandsOff AutopilotLevel
  minutesSaved    Decimal?        @db.Decimal(9, 2)
  originBoard     String?
  /// ADR-28: 'awaiting' until the Owner confirms a seeded default (S03-T04).
  signoffStatus   SignoffStatus   @default(not_required)
  /// ops.user(id) through a SQL foreign key (actor-column convention, not a Prisma relation).
  signedOffById   String?         @db.Uuid
  signedOffAt     DateTime?       @db.Timestamptz(3)

  setting     AutopilotSetting?
  actions     AssistantAction[]
  suggestions AutopilotSuggestion[]

  @@map("autopilot_action_def")
  @@schema("ops")
}

model AutopilotSetting {
  actionKey     String             @id
