// ─────────────────────────────────────────────────────────────────────────────
// Indus Operations — Prisma schema for the `ops` Postgres schema
//
// Lives at packages/ops-db/prisma/schema.prisma. Same Supabase database as the
// website (`public` schema, packages/db), separate schema, separate generated
// client, separate Postgres role (`ops_app`).
//
// Conventions (read before editing):
//   * Ids are UUIDv7 (`uuid(7)`, native `uuid` type). Human references (ENQ-…,
//     INDUS/Q…, IH-RFQ-…) are separate unique text columns, allocated by
//     ops.allocate_number() in SQL. Never use a human ref as a foreign key.
//   * Every DateTime is timestamptz. Calendar dates (validity, due date) are
//     `@db.Date`.
//   * Money: Decimal(18,4) + a Char(3) ISO currency column. FX rates:
//     Decimal(20,10). Percentages: Decimal(9,4) holding percent (15.4 = 15.4%).
//     Quantities: Decimal(18,4).
//   * Currency (Char(3)) and country (Char(2)) columns are foreign keys /
//     CHECKs in SQL only; they are not Prisma relations.
//   * Actor columns named `*ById` reference ops.user(id) through a SQL foreign
//     key. Only the actor columns the UI navigates are modelled as Prisma
//     relations; the rest are plain uuid columns, to keep `User` readable.
//   * Polymorphic links use (subjectType, subjectId). The deal space is the
//     Enquiry: anything that belongs to one carries a real `enquiryId` FK.
//   * The schema is NEVER pushed. SQL migrations in
//     packages/ops-db/migrations/YYYYMMDDHHMM_ops_*.sql are the source of truth for
//     the database; this file must be kept in step by hand
//     (CLAUDE.md §5.4). `tsvector` columns are generated in SQL and appear
//     here as Unsupported.
//   * Column names stay camelCase (quoted in SQL), table names snake_case via
//     @@map — the same convention as packages/db.
//   * This file is the S00 BASE schema. From S00 on, packages/ops-db/prisma/
//     schema.prisma in the repo is the schema of record; models added by later
//     sprints (architecture §5.1 "Schema deltas", e.g. ReminderStep, RfqChaser,
//     OrderException) exist only there. S37-T06 copies the as-built file back
//     next to this one as 06-ops-schema.as-built.prisma.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  // A separate output path is mandatory: packages/db generates the default
  // @prisma/client, and under Bun's isolated store both packages resolve the
  // same @prisma/client directory, so two clients generated to the default
  // place overwrite each other. Git-ignored; src/client-path.test.ts pins it.
  output          = "../generated/client"
  // rhel-openssl-3.0.x is the Vercel Functions runtime (Amazon Linux 2023). It is
  // listed explicitly: Vercel copies the engine of the DEFAULT @prisma/client
  // location for the website, but nothing does that for this custom path, and the
  // first Ops production deploy crashed with "could not locate the Query Engine
  // for runtime rhel-openssl-3.0.x". apps/ops `build` also runs prisma generate
  // itself, because Bun may skip postinstall on Vercel.
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
  previewFeatures = ["views", "fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  // Supavisor transaction pooler (6543) as ops_app, ?pgbouncer=true&connection_limit=1&pool_timeout=20.
  // The Ops Vercel project has its own env, so the names match packages/db.
  url       = env("DATABASE_URL")
  // Direct connection for `prisma db execute` only (migrations), never at runtime.
  directUrl = env("DIRECT_URL")
  schemas   = ["ops"]
}

