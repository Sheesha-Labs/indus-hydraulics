// ── Numbering ──────────────────────────────────────────────────────────────

/// One row per document family. Patterns are data (Settings › Numbering, 214).
model NumberSequence {
  key             String          @id
  label           String
  pattern         String
  revisionPattern String?
  scopeKind       NumberScopeKind @default(global)
  padTo           Int             @default(0)
  ownerOnly       Boolean         @default(true)
  /// Allocation is refused until a seed has been confirmed (INDUS/Q hand-over).
  seededAt        DateTime?       @db.Timestamptz(3)
  seededById      String?         @db.Uuid
  seedEvidence    Json?
  /// S08-T06: an outside allocator reached this sequence's block (ops.numbering.continuity).
  outOfStepAt     DateTime?       @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  counters     NumberCounter[]
  issued       IssuedNumber[]
  observations ExternalNumberObservation[]

  @@map("number_sequence")
  @@schema("ops")
}

model NumberCounter {
  sequenceKey String
  sequence    NumberSequence @relation(fields: [sequenceKey], references: [key])
  /// '' for global, '2026', '2611', '26-09-23', or a parent ref.
  scope       String         @default("")
  nextValue   BigInt
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@id([sequenceKey, scope])
  @@map("number_counter")
  @@schema("ops")
}

/// Every number ever handed out. The continuity check and gap audit read this.
model IssuedNumber {
  id          String             @id @default(uuid(7)) @db.Uuid
  sequenceKey String
  sequence    NumberSequence     @relation(fields: [sequenceKey], references: [key])
  scope       String             @default("")
  value       BigInt
  formatted   String
  status      IssuedNumberStatus @default(issued)
  recordType  RecordType?
  recordId    String?            @db.Uuid
  issuedAt    DateTime           @default(now()) @db.Timestamptz(3)
  issuedById  String?            @db.Uuid
  releasedAt  DateTime?          @db.Timestamptz(3)

  @@unique([sequenceKey, formatted])
  @@unique([sequenceKey, scope, value])
  @@index([recordType, recordId])
  @@map("issued_number")
  @@schema("ops")
}

/// Numbers seen outside Ops (Gmail sent mail, Zoho, legacy admin). The
/// allocator skips any value found here.
model ExternalNumberObservation {
  id          String               @id @default(uuid(7)) @db.Uuid
  sequenceKey String
  sequence    NumberSequence       @relation(fields: [sequenceKey], references: [key])
  formatted   String
  value       BigInt?
  scope       String               @default("")
  source      ExternalNumberSource
  sourceRef   String?
  observedAt  DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([sequenceKey, formatted, source])
  @@index([sequenceKey, scope, value])
  @@map("external_number_observation")
  @@schema("ops")
}

