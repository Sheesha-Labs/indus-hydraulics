/// ISO 4217 currencies the console may quote, buy or report in. Every
/// Char(3) currency column FKs here in SQL.
model Currency {
  code       String  @id @db.Char(3)
  name       String
  minorUnits Int     @default(2)
  active     Boolean @default(true)

  @@map("currency")
  @@schema("ops")
}

/// Trade / category taxonomy: drives trade groups, margin per category,
/// supplier line cards, lessons and part grouping.
model Trade {
  id               String    @id @default(uuid(7)) @db.Uuid
  name             String    @unique
  slug             String    @unique
  parentId         String?   @db.Uuid
  parent           Trade?    @relation("TradeTree", fields: [parentId], references: [id])
  children         Trade[]   @relation("TradeTree")
  defaultMarginPct Decimal?  @db.Decimal(9, 4)
  position         Int       @default(0)
  archivedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  tradeGroups TradeGroup[]
  lineCards   SupplierLineCard[]
  parts       Part[]
  lessons     Lesson[]
  leadLines   LeadLine[]

  @@map("trade")
  @@schema("ops")
}

/// Typed key/value settings validated by Zod in code (pricing.*, vat.*,
/// fx.*, intake.*, assistant.mode, brief.*, retention.*, company.profile …).
model SettingsEntry {
  key           String        @id
  value         Json
  version       Int           @default(0)
  ownerOnly     Boolean       @default(false)
  updatedById   String?       @db.Uuid
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  /// ADR-28: 'awaiting' until the Owner confirms a seeded default (S03-T04).
  signoffStatus SignoffStatus @default(not_required)
  /// ops.user(id) through a SQL foreign key (actor-column convention, not a Prisma relation).
  signedOffById String?       @db.Uuid
  signedOffAt   DateTime?     @db.Timestamptz(3)

  @@map("settings_entry")
  @@schema("ops")
}

/// Working calendar: UAE public holidays and Ramadan hours. Used for
/// working-day maths (reply-by, give-up dates, call-back countdown).
/// S04-T06: public holidays, Ramadan days and closures per country (send slots, boards 87 and 100). Content.
model Holiday {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country       String   @db.Char(2)
  date          DateTime @db.Date
  name          String
  /// public_holiday | ramadan | closure
  kind          String
  hoursStart    String?
  hoursEnd      String?
  signoffStatus String   @default("awaiting")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([country, date, kind], map: "holiday_country_date_kind_key")
  @@index([date])
  @@map("holiday")
  @@schema("ops")
}

model WorkCalendarDay {
  date       DateTime @id @db.Date
  label      String
  isHoliday  Boolean  @default(true)
  hoursStart String?
  hoursEnd   String?
  country    String   @default("AE") @db.Char(2)

  @@map("work_calendar_day")
  @@schema("ops")
}

