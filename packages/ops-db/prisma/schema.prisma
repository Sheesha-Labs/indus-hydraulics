// ═════════════════════════════════════════════════════════════════════════════
// ASSISTANT, AUDIT, AI COST
// ═════════════════════════════════════════════════════════════════════════════

/// The heart of the audit trail (P06). Rows are never deleted; only the
/// lifecycle columns may change (enforced by trigger), and every change is
/// also written to assistant_action_event.
model AssistantAction {
  id                String             @id @default(uuid(7)) @db.Uuid
  /// A-26-09-23-0412
  ref               String             @unique
  actionKey         String
  def               AutopilotActionDef @relation(fields: [actionKey], references: [key])
  levelAtTime       AutopilotLevel
  /// Guardrail keys that forced this into Review.
  guardrails        String[]
  enquiryId         String?            @db.Uuid
  enquiry           Enquiry?           @relation(fields: [enquiryId], references: [id])
  subjectType       RecordType?
  subjectId         String?            @db.Uuid
  // Proposal (immutable once written)
  headline          String
  /// [{ text, source: { type, id, url, page, span } }]
  reasons           Json
  preview           Json?
  /// [{ label, status: pass|warn|fail, detail }]
  checks            Json?
  confidence        Confidence?
  unsureAbout       String?
  onApproveText     String?
  /// Judgement-call options (107): [{ key, label, consequence }]
  options           Json?
  inputs            Json?
  output            Json?
  // Lifecycle (mutable)
  state             ActionState
  chosenOption      String?
  editDiff          Json?
  rejectReason      String?
  laterUntil        DateTime?          @db.Timestamptz(3)
  decidedById       String?            @db.Uuid
  decidedBy         User?              @relation("ActionDecidedBy", fields: [decidedById], references: [id])
  decidedAt         DateTime?          @db.Timestamptz(3)
  undoUntil         DateTime?          @db.Timestamptz(3)
  doneAt            DateTime?          @db.Timestamptz(3)
  failureReason     String?
  retryOfId         String?            @db.Uuid
  correctionOfId    String?            @db.Uuid
  correctionOf      AssistantAction?   @relation("Correction", fields: [correctionOfId], references: [id])
  corrections       AssistantAction[]  @relation("Correction")
  revertOfId        String?            @db.Uuid
  batchKey          String?
  // Review lifecycle (S06-T01, mutable)
  staleAt           DateTime?          @db.Timestamptz(3)
  staleReason       String?
  supersededById    String?            @db.Uuid
  blockedByActionId String?            @db.Uuid
  redraftOfId       String?            @db.Uuid
  effectivePayload  Json?
  costUsd           Decimal            @default(0) @db.Decimal(12, 6)
  // Runner columns (S05-T02). Immutable after insert except `version`, which the guard bumps on update.
  /// sha256 of the sorted source versions the proposal was built on; a stale basis cannot be approved.
  basisHash         String?
  /// `${actionKey}:${subjectType}:${subjectId}:${sourceVersion}`; one action per key.
  idempotencyKey    String?            @unique
  /// live | backfill | import | manual
  origin            String             @default("live")
  model             String?
  promptVersion     String?
  levelReasons      Json?
  /// review | mail_unsure | hint
  surface           String             @default("review")
  version           Int                @default(0)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  events             AssistantActionEvent[]
  aiCalls            AiCall[]
  aiReservations     AiReservation[]
  preferenceSignals  PreferenceSignal[]
  outbound           OutboundEmail[]
  guardrailTriggers  GuardrailTrigger[]
  preferenceEvidence PreferenceEvidence[]

  @@index([state, createdAt])
  @@index([enquiryId, createdAt])
  @@index([actionKey, createdAt])
  @@index([subjectType, subjectId])
  @@index([undoUntil])
  @@index([surface, state, createdAt])
  @@index([laterUntil], map: "assistant_action_later_idx")
  @@index([redraftOfId], map: "assistant_action_redraftOfId_idx")
  @@index([createdAt(sort: Desc)], map: "assistant_action_createdAt_idx")
  @@map("assistant_action")
  @@schema("ops")
}

/// Append-only: one row per state transition (INSERT-only grant).
model AssistantActionEvent {
  id        String          @id @default(uuid(7)) @db.Uuid
  actionId  String          @db.Uuid
  action    AssistantAction @relation(fields: [actionId], references: [id])
  fromState ActionState?
  toState   ActionState
  actorKind ActorKind
  actorId   String?         @db.Uuid
  note      String?
  at        DateTime        @default(now()) @db.Timestamptz(3)

  @@index([actionId, at])
  @@map("assistant_action_event")
  @@schema("ops")
}

/// One row per model call; the budget and Cost & limits (101) read this.
model AiCall {
  id                 String           @id @default(uuid(7)) @db.Uuid
  actionId           String?          @db.Uuid
  action             AssistantAction? @relation(fields: [actionId], references: [id])
  enquiryId          String?          @db.Uuid
  purpose            AiPurpose
  model              String
  inputTokens        Int
  outputTokens       Int
  cacheReadTokens    Int              @default(0)
  cacheWriteTokens   Int              @default(0)
  webSearches        Int              @default(0)
  costUsd            Decimal          @db.Decimal(12, 6)
  latencyMs          Int?
  ok                 Boolean          @default(true)
  error              String?
  /// classify-mail@1 (S05-T01)
  promptVersion      String?
  /// end_turn | max_tokens | refusal | … (checked before content is read)
  stopReason         String?
  /// low | medium | high | xhigh | max
  effort             String?
  cacheWrite1hTokens Int              @default(0)
  reservationId      String?          @db.Uuid
  at                 DateTime         @default(now()) @db.Timestamptz(3)

  @@index([at])
  @@index([enquiryId, purpose])
  @@map("ai_call")
  @@schema("ops")
}

/// Append-only field-level history for every record (113). INSERT-only grant.
model ActivityEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  at             DateTime     @default(now()) @db.Timestamptz(3)
  actorKind      ActorKind
  actorId        String?      @db.Uuid
  actionId       String?      @db.Uuid
  enquiryId      String?      @db.Uuid
  enquiry        Enquiry?     @relation(fields: [enquiryId], references: [id])
  subjectType    RecordType
  subjectId      String       @db.Uuid
  kind           ActivityKind
  field          String?
  before         Json?
  after          Json?
  note           String?
  /// Hidden from a Helper without canSeeMargins (margin, cost, sell).
  /// S06-T07: the change a revert row reverses.
  revertsEventId String?      @db.Uuid
  sensitive      Boolean      @default(false)

  @@index([enquiryId, at])
  @@index([subjectType, subjectId, field, at], map: "activity_event_subject_field_at_idx")
  @@index([subjectType, subjectId, at])
  @@map("activity_event")
  @@schema("ops")
}

/// One stored result per idempotent action call (architecture §4.10, S02-T08). defineAction reads
/// it before running an approve / send / pay handler and inserts it in the handler's transaction,
/// so a double-click or a retry returns the first result. ops_app has no UPDATE on this table.
model ActionIdempotency {
  /// `<action name>:<caller key>`, e.g. `proposal.approve:<proposalId>:<version>`.
  key       String   @id
  action    String
  /// ops.user(id) through a SQL foreign key (actor-column convention, not a Prisma relation).
  userId    String   @db.Uuid
  /// The Result JSON every replay returns.
  result    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("action_idempotency")
  @@schema("ops")
}

// ═════════════════════════════════════════════════════════════════════════════
// WORK AND ATTENTION
// ═════════════════════════════════════════════════════════════════════════════

model Task {
  id                String      @id @default(uuid(7)) @db.Uuid
  title             String
  kind              TaskKind    @default(general)
  source            TaskSource  @default(manual)
  status            TaskStatus  @default(open)
  dueAt             DateTime?   @db.Timestamptz(3)
  assigneeId        String?     @db.Uuid
  assignee          User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  enquiryId         String?     @db.Uuid
  enquiry           Enquiry?    @relation(fields: [enquiryId], references: [id])
  subjectType       RecordType?
  subjectId         String?     @db.Uuid
  notes             String?
  createdByActionId String?     @db.Uuid
  createdById       String?     @db.Uuid
  completedAt       DateTime?   @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)

  @@index([assigneeId, status, dueAt])
  @@index([enquiryId])
  @@map("task")
  @@schema("ops")
}

/// Resolves itself when the thing is done (resolvedAt).
model Notification {
  id          String               @id @default(uuid(7)) @db.Uuid
  userId      String               @db.Uuid
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       NotificationEvent
  severity    NotificationSeverity @default(info)
  title       String
  body        String?
  enquiryId   String?              @db.Uuid
  enquiry     Enquiry?             @relation(fields: [enquiryId], references: [id])
  subjectType RecordType?
  subjectId   String?              @db.Uuid
  actionUrl   String?
  /// e.g. "bank_change:<accountId>" — one open notification per thing.
  dedupeKey   String
  channels    DeliveryChannel[]
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  readAt      DateTime?            @db.Timestamptz(3)
  resolvedAt  DateTime?            @db.Timestamptz(3)

  /// Partial unique in SQL: (userId, dedupeKey) WHERE resolvedAt IS NULL.
  /// Partial in SQL: WHERE resolvedAt IS NULL (S05-T09).
  @@index([dedupeKey], map: "notification_open_dedupeKey_idx")
  @@index([userId, dedupeKey])
  @@index([userId, resolvedAt, createdAt])
  @@map("notification")
  @@schema("ops")
}

model SavedSearch {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  queryText  String
  /// The structured query the Assistant ran, shown to the user (209).
  structured Json?
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@map("saved_search")
  @@schema("ops")
}

/// One row per searchable record, maintained by triggers (command bar, 208).
model SearchDocument {
  id          String                   @id @default(uuid(7)) @db.Uuid
  kind        SearchKind
  recordId    String                   @db.Uuid
  enquiryId   String?                  @db.Uuid
  /// Primary reference(s): "ENQ-2026-0419", "INDUS/Q26941-R2 Q26941 26941".
  refs        String[]
  title       String
  body        String?
  partNosNorm String[]
  occurredAt  DateTime?                @db.Timestamptz(3)
  /// Contains margin or cost terms; hidden from a Helper without canSeeMargins.
  sensitive   Boolean                  @default(false)
  searchTsv   Unsupported("tsvector")?
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(3)

  @@unique([kind, recordId])
  @@index([enquiryId])
  @@map("search_document")
  @@schema("ops")
}

// ═════════════════════════════════════════════════════════════════════════════
// HISTORY IMPORT (P07), CHECKLISTS, CUTOVER
// ═════════════════════════════════════════════════════════════════════════════

model ImportJob {
  id          String          @id @default(uuid(7)) @db.Uuid
  sources     ImportSource[]
  monthsBack  Int             @default(24)
  exclusions  Json            @default("{}")
  budgetUsd   Decimal         @db.Decimal(12, 6)
  costUsd     Decimal         @default(0) @db.Decimal(12, 6)
  status      ImportJobStatus @default(draft)
  counters    Json            @default("{}")
  startedById String?         @db.Uuid
  startedAt   DateTime?       @db.Timestamptz(3)
  pausedAt    DateTime?       @db.Timestamptz(3)
  finishedAt  DateTime?       @db.Timestamptz(3)
  undoneAt    DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  stages     ImportStage[]
  candidates ImportCandidate[]
  records    ImportedRecord[]

  @@map("import_job")
  @@schema("ops")
}

model ImportStage {
  id         String            @id @default(uuid(7)) @db.Uuid
  jobId      String            @db.Uuid
  job        ImportJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  key        String
  label      String
  status     ImportStageStatus @default(queued)
  total      Int?
  done       Int               @default(0)
  /// Resumable cursor (page token, last id, last date).
  cursor     Json?
  position   Int
  startedAt  DateTime?         @db.Timestamptz(3)
  finishedAt DateTime?         @db.Timestamptz(3)

  @@unique([jobId, key])
  @@map("import_stage")
  @@schema("ops")
}

/// Staging row proposed for review (118–120). Nothing reaches the live
/// tables until accepted.
model ImportCandidate {
  id           String                @id @default(uuid(7)) @db.Uuid
  jobId        String                @db.Uuid
  job          ImportJob             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  entity       ImportEntity
  sourceSystem ImportSource
  sourceKey    String
  payload      Json
  confidence   Confidence
  evidence     Json?
  flags        Json?
  status       ImportCandidateStatus @default(pending)
  mergeWithId  String?               @db.Uuid
  targetType   RecordType?
  targetId     String?               @db.Uuid
  decidedById  String?               @db.Uuid
  decidedAt    DateTime?             @db.Timestamptz(3)

  @@unique([jobId, entity, sourceSystem, sourceKey])
  @@index([jobId, entity, status, confidence])
  @@map("import_candidate")
  @@schema("ops")
}

/// Provenance for undo and idempotent re-runs: one row per live record an
/// import (or the cutover) created.
model ImportedRecord {
  id           String       @id @default(uuid(7)) @db.Uuid
  jobId        String?      @db.Uuid
  job          ImportJob?   @relation(fields: [jobId], references: [id])
  sourceSystem ImportSource
  /// e.g. "public.quotes:5b1e…", "zoho.estimate:4600000123", "gmail:sales:18c…"
  sourceKey    String
  recordType   RecordType
  recordId     String       @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  undoneAt     DateTime?    @db.Timestamptz(3)

  @@unique([sourceSystem, sourceKey, recordType])
  @@index([jobId])
  @@index([recordType, recordId])
  @@map("imported_record")
  @@schema("ops")
}

/// Setup wizard (78–83), cutover checklist (237), first hour (224).
model ChecklistItem {
  id           String              @id @default(uuid(7)) @db.Uuid
  checklist    ChecklistKind
  key          String
  label        String
  position     Int
  ownerOnly    Boolean             @default(false)
  status       ChecklistItemStatus @default(todo)
  detail       Json?
  rollbackNote String?
  doneById     String?             @db.Uuid
  doneAt       DateTime?           @db.Timestamptz(3)

  @@unique([checklist, key])
  @@map("checklist_item")
  @@schema("ops")
}

// ═════════════════════════════════════════════════════════════════════════════
// READ-ONLY CATALOGUE VIEWS over the website's `public` schema.
// Owned by postgres (security definer semantics) so ops_app needs no grant on
// public tables. Only active products, only the columns Ops needs.
// ═════════════════════════════════════════════════════════════════════════════

/// S10: one row per tier decision (boards 51, 130, 131). Insert-only for ops_app.
model SupplierApproval {
  id          String        @id @default(uuid(7)) @db.Uuid
  supplierId  String        @db.Uuid
  /// propose | send_back | approve | approve_trial | reject | promote | block | unblock (CHECK).
  decision    String
  fromTier    SupplierTier?
  toTier      SupplierTier?
  conditions  Json          @default("[]")
  reason      String?
  decidedById String?       @db.Uuid
  decidedAt   DateTime      @default(now()) @db.Timestamptz(3)
  actionId    String?       @db.Uuid

  @@index([supplierId, decidedAt(sort: Desc)])
  @@map("supplier_approval")
  @@schema("ops")
}

/// S10-T04: the secure upload link sent to a new supplier (board 50, /u/[token]). Only the token's SHA-256 is stored.
model SupplierDocumentRequest {
  id             String    @id @default(uuid(7)) @db.Uuid
  supplierId     String    @db.Uuid
  supplier       Company   @relation(fields: [supplierId], references: [id])
  contactId      String?   @db.Uuid
  tokenHash      String    @unique
  requestedKinds String[]
  expiresAt      DateTime  @db.Timestamptz(3)
  nextReminderAt DateTime? @db.Timestamptz(3)
  remindersSent  Int       @default(0)
  remindersOn    Boolean   @default(true)
  /// open | completed | expired | revoked (CHECK).
  status         String    @default("open")
  outboundId     String?   @db.Uuid
  actionId       String?   @db.Uuid
  threadId       String?   @db.Uuid
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  uploads SupplierDocumentUpload[]

  @@index([status, nextReminderAt])
  @@index([supplierId, createdAt(sort: Desc)])
  @@map("supplier_document_request")
  @@schema("ops")
}

model SupplierDocumentUpload {
  id                   String                  @id @default(uuid(7)) @db.Uuid
  requestId            String                  @db.Uuid
  request              SupplierDocumentRequest @relation(fields: [requestId], references: [id])
  storedFileId         String                  @db.Uuid
  kind                 String
  complianceDocumentId String?                 @db.Uuid
  complianceDocument   ComplianceDocument?     @relation(fields: [complianceDocumentId], references: [id])
  uploadedAt           DateTime                @default(now()) @db.Timestamptz(3)
  ipHash               String?
  userAgentClass       String?

  @@index([requestId])
  @@map("supplier_document_upload")
  @@schema("ops")
}

/// S10-T02 board 11: one row per live client (ops.client_stats_v).
view ClientStats {
