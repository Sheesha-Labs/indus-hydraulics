  /// Per-action rules, e.g. chaser { firstAfterDays: 1, everyDays: 2, max: 3 }.
  rules         Json               @default("{}")
  version       Int                @default(0)
  updatedById   String?            @db.Uuid
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  /// ADR-28 (S07): 'awaiting' until the Owner saves the row.
  signoffStatus SignoffStatus      @default(awaiting)
  /// ops.user(id) through a SQL foreign key (actor-column convention, not a Prisma relation).
  signedOffById String?            @db.Uuid
  signedOffAt   DateTime?          @db.Timestamptz(3)

  @@map("autopilot_setting")
  @@schema("ops")
}

