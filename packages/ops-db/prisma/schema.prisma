/// Fixed-window rate-limit counters (S03-T01, architecture §4.11). Written only through
/// ops.hit_rate_limit(key, windowSeconds, max); keys hold hashes, never a raw address or email.
model RateLimitCounter {
  key         String
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_counter")
  @@schema("ops")
}

/// S05-T01: USD per million tokens (per thousand web searches), effective from a date. Data, not code.
model AiModelPrice {
  model            String
  effectiveFrom    DateTime @db.Date
  inputPerM        Decimal  @db.Decimal(12, 4)
  outputPerM       Decimal  @db.Decimal(12, 4)
  cacheReadPerM    Decimal  @db.Decimal(12, 4)
  cacheWrite5mPerM Decimal  @db.Decimal(12, 4)
  cacheWrite1hPerM Decimal  @db.Decimal(12, 4)
  webSearchPerK    Decimal  @default(10) @db.Decimal(12, 4)
  signoffStatus    String   @default("awaiting")
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@id([model, effectiveFrom])
  @@map("ai_model_price")
  @@schema("ops")
}

/// S05-T01: one row per Asia/Dubai calendar month (its first day). Reserved and settled only through
/// ops.ai_budget_reserve / ops.ai_budget_settle.
model AiBudget {
  month         DateTime        @id @db.Date
  limitUsd      Decimal         @db.Decimal(12, 4)
  /// warn_pause_research | hard_stop | warn_only
  mode          String          @default("warn_pause_research")
  spentUsd      Decimal         @default(0) @db.Decimal(12, 6)
  reservedUsd   Decimal         @default(0) @db.Decimal(12, 6)
  notified80At  DateTime?       @db.Timestamptz(3)
  notified100At DateTime?       @db.Timestamptz(3)
  signoffStatus String          @default("awaiting")
  updatedAt     DateTime        @default(now()) @db.Timestamptz(3)
  reservations  AiReservation[]

  @@map("ai_budget")
  @@schema("ops")
}

model AiReservation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  month     DateTime         @db.Date
  budget    AiBudget         @relation(fields: [month], references: [month], onDelete: Restrict, map: "ai_reservation_month_fkey")
  purpose   String
  estUsd    Decimal          @db.Decimal(12, 6)
  actionId  String?          @db.Uuid
  action    AssistantAction? @relation(fields: [actionId], references: [id], onDelete: SetNull, map: "ai_reservation_action_fkey")
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  settledAt DateTime?        @db.Timestamptz(3)
  actualUsd Decimal?         @db.Decimal(12, 6)

  @@index([month])
  @@map("ai_reservation")
  @@schema("ops")
}

/// S05-T02: the single row behind "Pause everything" (id = 1).
model AssistantState {
  id          Int       @id @default(1) @db.SmallInt
  pausedAt    DateTime? @db.Timestamptz(3)
  pausedById  String?   @db.Uuid
  pauseNote   String?
  resumedAt   DateTime? @db.Timestamptz(3)
  resumedById String?   @db.Uuid
  version     Int       @default(0)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@map("assistant_state")
  @@schema("ops")
}

/// S05-T02: shell live counts (mail.unsure, mail.not_linked, …), one upsert per bump.
model LiveCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("live_counter")
  @@schema("ops")
}

/// S05-T02: what a person's edits, rejections and choices say about how they want things done.
model PreferenceSignal {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// edit | reject | unsure_choice | override | sent_mail
  kind        String
  actionId    String?          @db.Uuid
  action      AssistantAction? @relation(fields: [actionId], references: [id], onDelete: SetNull, map: "preference_signal_action_fkey")
  actionKey   String?
  companyId   String?          @db.Uuid
  mailboxId   String?          @db.Uuid
  payload     Json             @default("{}")
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  consumedAt  DateTime?        @db.Timestamptz(3)

  @@index([companyId, createdAt], map: "preference_signal_company_idx")
  @@index([createdAt], map: "preference_signal_unconsumed_idx")
  @@map("preference_signal")
  @@schema("ops")
}

/// S05-T04: a verbatim quote a model cited, resolved to its place in the source (ADR-12 Why?).
model SourceSpan {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// email | pdf | sheet | image | docx
  sourceKind String
  sourceId   String   @db.Uuid
  textHash   String?
  page       Int?
  sheet      String?
  cellRef    String?
  charStart  Int?
  charEnd    Int?
  bbox       Json?
  quote      String
  /// exact | fuzzy | page_only | unresolved
  resolved   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([sourceKind, sourceId])
  @@map("source_span")
  @@schema("ops")
}

/// S06-T04: the Assistant log feed (board 111). Actions, people's decisions on cards, people's own changes.
view AssistantLogEntry {
  id              String   @unique @db.Uuid
  at              DateTime @db.Timestamptz(3)
  kind            String
  actorKind       String
  actorId         String?  @db.Uuid
  actorInitials   String?
  actionId        String?  @db.Uuid
  actionRef       String?
  actionKey       String?
  enquiryId       String?  @db.Uuid
  enquiryRef      String?
  subjectType     String?
  subjectId       String?  @db.Uuid
  level           String?
  outcome         String
  deciderInitials String?
  edited          Boolean
  surface         String?
  costUsd         Decimal  @db.Decimal(12, 6)
  headline        String

  @@map("assistant_log_v")
  @@schema("ops")
}

/// S07-T01 · one row per guardrail that fired on an Assistant run (board 100 counters, "Last triggered").
/// Append-only for ops_app (SELECT, INSERT).
model GuardrailTrigger {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guardrailKey String
  actionId     String?          @db.Uuid
  action       AssistantAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  actionKey    String
  /// ask | queue | block
  effect       String           @default("ask")
  /// What the Review card printed ("Outside working hours · queued for 08:30").
  text         String           @default("")
  at           DateTime         @default(now()) @db.Timestamptz(3)

  @@index([guardrailKey, at])
  @@index([at(sort: Desc)])
  @@map("guardrail_trigger")
  @@schema("ops")
}

/// S07-T02 · an earned suggestion: 25 clean approvals since the last level change → one level up. It never
/// changes a level; the Owner accepts (setLevel) or snoozes it (dismissedUntil). One open row per action.
model AutopilotSuggestion {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actionKey      String
  def            AutopilotActionDef @relation(fields: [actionKey], references: [key], onDelete: Cascade)
  /// 'earned' (CHECK in SQL)
  kind           String             @default("earned")
  fromLevel      AutopilotLevel
  toLevel        AutopilotLevel
  streak         Int
  evidence       Json               @default("{}")
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  dismissedUntil DateTime?          @db.Timestamptz(3)
  acceptedAt     DateTime?          @db.Timestamptz(3)
  /// ops.user(id) through a SQL foreign key (actor-column convention).
  acceptedById   String?            @db.Uuid

  @@map("autopilot_suggestion")
  @@schema("ops")
}

/// S07-T05 · one Message Batches submission of the nightly preference learner.
model PreferenceLearnBatch {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anthropicBatchId String?   @unique(map: "preference_learn_batch_anthropicBatchId_key")
  /// submitted | in_progress | ended | failed | applied
  status           String    @default("submitted")
  signalIds        String[]  @db.Uuid
  /// The groups sent, by custom_id: signal ids, action key, scope ids, occurrences.
  groups           Json      @default("[]")
  submittedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt          DateTime? @db.Timestamptz(3)
  error            String?

  @@index([submittedAt], map: "preference_learn_batch_open_idx")
  @@map("preference_learn_batch")
  @@schema("ops")
}

// ── S08 · Enquiry intake ─────────────────────────────────────────────────────────────────

enum IntakeSource {
  upload
  mail
  paste

  @@schema("ops")
}

enum IntakeBatchStatus {
  open
  confirmed
  cancelled

  @@schema("ops")
}

enum IntakeFileStatus {
  queued
  extracting
  ready
  needs_attention
  cancelled
  removed

  @@schema("ops")
}

/// Units extraction normalises to (S08-T02).
model UomUnit {
  code    String     @id
  label   String
  /// count | length | mass | volume | pack
  kind    String
  aliases UomAlias[]

  @@map("uom_unit")
  @@schema("ops")
}

model UomAlias {
  alias    String  @id
  unitCode String
  unit     UomUnit @relation(fields: [unitCode], references: [code], onDelete: Cascade)

  @@map("uom_alias")
  @@schema("ops")
}

/// Board 35: a client's spreadsheet layout, remembered (S08-T05).
model ClientColumnMapping {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @db.Uuid
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileSignature String
  sheetName     String?
  headerRow     Int
  mapping       Json
  byHeader      Json      @default("{}")
  unitOverrides Json      @default("{}")
  usedCount     Int       @default(0)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  files IntakeFile[]

  @@unique([companyId, fileSignature])
  @@index([companyId, lastUsedAt(sort: Desc)])
  @@map("client_column_mapping")
  @@schema("ops")
}

/// One intake (board 14 upload session, board 36 email read, a paste): staging until a person confirms (S08-T03).
model IntakeBatch {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source            IntakeSource
  status            IntakeBatchStatus @default(open)
  mailMessageId     String?           @db.Uuid
  mailMessage       MailMessage?      @relation(fields: [mailMessageId], references: [id], onDelete: SetNull)
  createdById       String?           @db.Uuid
  createdByActionId String?           @db.Uuid
  clientCompanyId   String?           @db.Uuid
  clientCompany     Company?          @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  contactId         String?           @db.Uuid
  enquiryId         String?           @db.Uuid
  enquiry           Enquiry?          @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  leadId            String?           @db.Uuid
  clientRef         String?
  deadline          DateTime?         @db.Timestamptz(3)
  terms             Json?
  revisionIntent    Json?
  confirmedAt       DateTime?         @db.Timestamptz(3)
  confirmedById     String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  version           Int               @default(0)

  files      IntakeFile[]
  candidates IntakeLineCandidate[]

  @@index([status, createdAt(sort: Desc)])
  @@index([mailMessageId])
  @@map("intake_batch")
  @@schema("ops")
}

model IntakeFile {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId          String               @db.Uuid
  batch            IntakeBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  storedFileId     String?              @db.Uuid
  storedFile       StoredFile?          @relation(fields: [storedFileId], references: [id], onDelete: SetNull)
  mailAttachmentId String?              @db.Uuid
  parentFileId     String?              @db.Uuid
  filename         String
  /// pdf | sheet | docx | image | email | paste | zip | other
  kind             String
  status           IntakeFileStatus     @default(queued)
  progressPct      Int                  @default(0)
  progressNote     String?
  pageCount        Int?
  sizeBytes        Int?
  /// unreadable | password_protected | unsupported | too_large | failed
  failureKind      String?
  failureNote      String?
  actionId         String?              @db.Uuid
  mappingId        String?              @db.Uuid
  mapping          ClientColumnMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  /// Board 35's working mapping for a sheet (S08-T05): sheet, headerRow, signature, columns, units, remember, confirmedAt.
  sheetMap         Json?
  linesFound       Int                  @default(0)
  linesToCheck     Int                  @default(0)
  uploadedById     String?              @db.Uuid
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  candidates IntakeLineCandidate[]

  @@index([batchId, status])
  @@index([status, createdAt])
  @@map("intake_file")
  @@schema("ops")
}

/// An extracted line waiting for a person. Never an enquiry_line until confirmed (S08-T04/T06).
model IntakeLineCandidate {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId            String                @db.Uuid
  batch              IntakeBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fileId             String?               @db.Uuid
  file               IntakeFile?           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  ord                Int
  description        String                @default("")
  qty                Decimal?              @db.Decimal(18, 4)
  qtyPrinted         String?
  uom                String?
  uomRaw             String?
  uomMethod          String?
  partNo             String?
  partNoNorm         String?
  make               String?
  spec               String?
  certification      String?
  clientRef          String?
  notes              String?
  confidence         Confidence            @default(unsure)
  reasons            Json                  @default("[]")
  unsure             Json?
  duplicateOfId      String?               @db.Uuid
  duplicateOf        IntakeLineCandidate?  @relation("CandidateDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates         IntakeLineCandidate[] @relation("CandidateDuplicate")
  /// pending | accepted | edited | merged | removed
  decision           String                @default("pending")
  decidedById        String?               @db.Uuid
  decidedAt          DateTime?             @db.Timestamptz(3)
  partId             String?               @db.Uuid
  part               Part?                 @relation(fields: [partId], references: [id], onDelete: SetNull)
  partMatch          String?
  catalogueProductId String?
  spanIds            String[]              @default([]) @db.Uuid
  fieldSpans         Json                  @default("{}")
  sourcePage         Int?
  sourceKind         String?
  sourceDetail       String?
  version            Int                   @default(0)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([batchId, ord])
  @@index([fileId])
  @@map("intake_line_candidate")
  @@schema("ops")
}

/// Board 04 (S09-T02): one row per enquiry with its C7 display group, line coverage, latest quotation and client PO.
view EnquiryPipelineRow {
  id                    String    @unique @db.Uuid
  ref                   String
  title                 String
  clientId              String?   @db.Uuid
  clientName            String?
  ownerId               String?   @db.Uuid
  ownerInitials         String?
  deadline              DateTime? @db.Timestamptz(3)
  receivedAt            DateTime  @db.Timestamptz(3)
  stage                 String
  stageGroup            String
  value                 Decimal?  @db.Decimal(18, 4)
  valueCurrency         String?
  linesTotal            Int
  linesSent             Int
  linesQuoted           Int
  quotationNumber       String?
  quotationStatus       String?
  quotationClientStatus String?
  clientPoRef           String?
  version               Int
  chosenPath            String?
  stageChangedAt        DateTime  @db.Timestamptz(3)

  @@map("enquiry_pipeline_v")
  @@schema("ops")
}

/// Board 04 filter chips: enquiries by display group and owner.
view EnquiryFilterCount {
  stageGroup String
  ownerId    String? @db.Uuid
  n          Int

  @@unique([stageGroup, ownerId])
  @@map("enquiry_filter_counts_v")
  @@schema("ops")
}
