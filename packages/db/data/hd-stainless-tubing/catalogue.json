 "products": [
  {
   "sku": "IH-TB-ST4",
   "slug": "304-stainless-steel-seamless-tubing-inch",
   "title": "304 Stainless Steel Seamless Tubing, Inch",
   "category": "stainless-steel-instrumentation-tubing",
   "focusKeyword": "304 stainless steel seamless tubing",
   "descriptionShort": "304 Stainless Steel Seamless Tubing, Inch: 28 sizes, 1/8\" to 1-1/2\" O.D., 0.028\" to 0.134\" wall, to ASTM A269 and ASTM A213.",
   "descriptionLong": "<p>304 stainless steel seamless tubing in inch outside diameters, for instrument, sample, hydraulic and process lines made up with compression tube fittings. It is seamless, with no weld seam.</p><h3>Specification</h3><ul><li>Grade: 304 stainless steel</li><li>Standards: ASTM A269 and ASTM A213</li><li>Outside diameter: 1/8\" to 1-1/2\" O.D.</li><li>Wall: 0.028\" to 0.134\" wall</li><li>Supplied in 20 ft lengths; minimum order 200 ft</li></ul><h3>Sizes</h3><p>28 part numbers: each is one O.D. in one wall thickness. The Sizes &amp; Part Numbers tab lists them.</p><h3>Pressure rating</h3><p>The manufacturer publishes no pressure rating. A tube holds what its O.D., wall, grade and temperature allow, and the fittings must suit the same wall; tell us the working pressure and temperature and we will confirm the wall to use.</p><h3>Using it with tube fittings</h3><p>Compression fittings grip on the tube O.D.: use fully annealed tube of the right hardness, cut it square, deburr it, and stay inside the wall range the fitting maker allows for each size.</p><h3>How to order</h3><p>Quote the Indus part number, or send the O.D., wall and length. Price, lead time and freight are confirmed with the quotation.</p>",
   "seoTitle": "304 Stainless Steel Seamless Tubing, Inch",
   "seoDescription": "304 stainless seamless tubing to ASTM A269 and ASTM A213: 1/8\" to 1-1/2\" O.D., 0.028\" to 0.134\" wall, 20 ft lengths. Quote from Indus Hydraulics, UAE.",
   "faqs": [
    {
     "question": "What lengths is it supplied in?",
     "answer": "20 ft lengths, with a minimum order of 200 ft."
    },
    {
     "question": "Is it seamless?",
     "answer": "Yes, seamless tube to ASTM A269 and A213."
    },
    {
     "question": "What pressure is it rated for?",
     "answer": "The manufacturer publishes no rating. Tell us the O.D., wall, working pressure and temperature and we will confirm it."
    },
    {
     "question": "What is the lead time?",
     "answer": "Price, lead time and freight are confirmed with the quotation."
    }
