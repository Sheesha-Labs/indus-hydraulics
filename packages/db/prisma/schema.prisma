model NotFoundLog {
  id                 String   @id @default(uuid())
  path               String   @unique
  referer            String?
  userAgent          String?
  hits               Int      @default(1)
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  resolvedRedirectId String?

  @@index([hits])
  @@map("not_found_logs")
}

// Phase 2 — Google Search Console daily metrics
model GscMetricDaily {
  id          String   @id @default(uuid())
  url         String
  date        DateTime @db.Date
  query       String? // null row = page-level totals
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  @@unique([url, date, query])
  @@index([url, date])
  @@map("gsc_metric_daily")
}

// Phase 3 — link-graph crawler
model CrawlRun {
  id           String         @id @default(uuid())
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  pagesCrawled Int            @default(0)
  edges        CrawlEdge[]
  findings     CrawlFinding[]

  @@map("crawl_runs")
}

model CrawlEdge {
  id         String   @id @default(uuid())
  runId      String
  fromUrl    String
  toUrl      String
  status     Int
  isInternal Boolean
  rel        String?
  run        CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, toUrl])
  @@map("crawl_edges")
}

model CrawlFinding {
  id     String   @id @default(uuid())
  runId  String
  kind   String // orphan | broken | redirect_chain | deep | dup_canonical
  url    String
  detail Json
  run    CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, kind])
  @@map("crawl_findings")
}

// ─────────────────────────────────────────────────────────────────────────────
// COUNTERS — atomic monotonic sequences for user-facing codes
// (RFQ-YYYY-NNNN, ACC-YYYY-NNNN, INDUS/Q{N}). The composite primary key
// forces a row-level write lock during increment, eliminating the race
// that `db.<model>.count() + 1` had.
// ─────────────────────────────────────────────────────────────────────────────

model Counter {
  scope     String
  year      Int // 0 for non-year-scoped scopes (e.g. global "quote")
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([scope, year])
  @@map("counters")
}

// ─────────────────────────────────────────────────────────────────────────────
// NEWSLETTER — anonymous email capture from homepage + future CTAs. Leads
// who may or may not become accounts. Status enum lets us reactivate
// unsubscribes without losing the record (history matters for opt-in proof).
// ─────────────────────────────────────────────────────────────────────────────

enum NewsletterSubscriberStatus {
  active
  unsubscribed
  bounced
}

model NewsletterSubscriber {
  id             String                     @id @default(uuid())
  email          String                     @unique
  status         NewsletterSubscriberStatus @default(active)
  source         String? // e.g. "homepage_footer", "quote_thanks"
  ipHash         String? // sha256 of submitter IP; never raw
  userAgent      String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  unsubscribedAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("newsletter_subscribers")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPETITOR SCRAPER
// ─────────────────────────────────────────────────────────────────────────────

enum ScraperJobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum ScrapedProductSelectionStatus {
  pending
  selected
  skipped
  ingested
  ingest_failed
}

enum ScrapedProductIngestMode {
  create_new
  attach_to_existing
}

model ScraperJob {
  id               String           @id @default(uuid())
  code             String           @unique // SCRAPE-YYYY-NNNN
  sourceUrl        String
  hostname         String
  status           ScraperJobStatus @default(queued)
  startedAt        DateTime?
  finishedAt       DateTime?
  totalFound       Int              @default(0)
  errorMessage     String?
  notes            String?
  createdByStaffId String? // soft FK to StaffUser.id
  options          Json             @default("{}") // { urlList?: string[], adapterHint?: string }
  scrapedProducts  ScrapedProduct[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@map("scraper_jobs")
}

model ScrapedProduct {
  id                  String                        @id @default(uuid())
  jobId               String
  job                 ScraperJob                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceUrl           String
  sourceTitle         String
  sourceDescription   String?
  sourceCategoryText  String?
  sourceBrandText     String?
  sourceSku           String?
  candidateImages     Json // [{url, position, alt?, contentType?, bytes?}]
  selectionStatus     ScrapedProductSelectionStatus @default(pending)
  ingestMode          ScrapedProductIngestMode      @default(create_new)
  targetProductId     String? // soft FK to Product.id — set when ingestMode='attach_to_existing'
  mappedCategoryId    String? // soft FK to Category.id — only used in create_new mode
  mappedBrandId       String? // soft FK to Brand.id — only used in create_new mode
  editedTitle         String? // only used in create_new mode
  editedSku           String? // only used in create_new mode
  deselectedImageUrls Json                          @default("[]") // string[]
  ingestedProductId   String? // soft FK to Product.id — receives images (new OR existing); not unique because attach mode can target same product from multiple rows
  ingestedAt          DateTime?
  ingestError         String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([jobId, sourceUrl])
  @@index([jobId, selectionStatus])
  @@map("scraped_products")
}

/// Why a staff invitation exists. Invites and password resets are the same
/// mechanism — a single-use, expiring, emailed link that ends at a
/// set-your-password screen — so they share one table rather than two
/// near-identical ones. The purpose only changes the copy and the TTL.
enum InvitationPurpose {
  invite
  reset
}

/// Single-use link for staff onboarding and password resets.
///
/// The raw token is NEVER stored. Only sha256(token) is persisted, so a
/// database read — a backup, a logged query, a leaked connection string —
/// cannot be turned into account access. Mirrors PasswordResetToken on the
/// customer side.
model StaffInvitation {
  id      String            @id @default(uuid())
  email   String
  name    String
  role    StaffRole
  purpose InvitationPurpose @default(invite)

  /// sha256 of the emailed token, hex. Unique so lookup is a single indexed
  /// read rather than a scan-and-compare.
  tokenHash String @unique

  invitedById String?
  invitedBy   StaffUser? @relation("StaffInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  expiresAt   DateTime
  /// Set the moment the link is consumed. This — not the existence of a
  /// StaffUser row — is what makes a link single-use.
  activatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("staff_invitations")
}
