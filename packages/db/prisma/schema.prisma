// Indus Hydraulics — Prisma Schema
// Canonical source of truth for all database entities.
// Excludes: pricing_rule, pricing_evaluation_log, inventory_*, purchase_order_* (out of scope)

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum AccountTier {
  bronze
  silver
  gold
  platinum
}

enum AccountStatus {
  prospect
  active
  at_risk
  archived
}

enum Currency {
  USD
  INR
  EUR
  AED
  SAR
}

enum ContactRole {
  procurement
  engineer
  ap
  approver
  admin
}

enum SsoProvider {
  microsoft365
}

enum AddressKind {
  ship_to
  bill_to
  both
}

enum StaffRole {
  super_admin
  manager
  sales_rep
  engineer
  warehouse
  finance
  cms_editor
}

enum ActivityActorType {
  contact
  staff
  system
}

enum ProductStatus {
  draft
  active
  discontinued
}

enum UnitOfMeasure {
  each
  metre
  kit
  set
}

enum MediaKind {
  image
  document
  cad
}

enum DocumentKind {
  datasheet
  step
  iges
  service_manual
  installation_guide
}

enum CrossRefCompatibility {
  direct
  compatible
  superseded_by_us
}

enum RfqStatus {
  draft
  submitted
  engineer_review
  engineer_questions_pending
  quote_sent
  accepted
  declined
  expired
  order_created
  cancelled
}

enum RfqUrgency {
  routine
  priority
  plant_down
}

enum OrderStatus {
  pending_credit_check
  credit_approved
  picking
  packed
  shipped
  delivered
  closed
  on_hold
}

enum SavedListVisibility {
  private
  team
  account
}

enum ReorderCadence {
  monthly
  quarterly
  biannual
  annual
}

enum NotificationKind {
  rfq_status_change
  quote_sent
  order_shipped
  mention
  password_reset
}

enum NotificationRecipientKind {
  contact
  staff
}

enum ImportEntity {
  product
  customer
  pricing_rule
}

enum ImportStatus {
  uploaded
  mapping
  validating
  previewing
  committing
  completed
  failed
  rolled_back
}

enum ImportRowOutcome {
  created
  updated
  warning
  error
  skipped
}

enum SpecFieldType {
  text
  number
  boolean
  select
}

enum ChangeFreq {
  always
  hourly
  daily
  weekly
  monthly
  yearly
  never
}

enum SeoEntityType {
  product
  category
  brand
  industry
  cms_page
  blog_post
}

enum AiPromptKind {
  meta_title
  meta_description
  schema_description
  alt_text
  faq
  long_description
  focus_keywords
}

enum AiSuggestionStatus {
  pending
  accepted
  rejected
  superseded
}

enum MenuLocation {
  primary_header
  primary_megamenu
  footer_main
  footer_legal
  mobile_drawer
}

enum MenuLinkType {
  none
  category
  brand
  industry
  cms_page
  product
  custom_url
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY & ACCOUNTS
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                      String        @id @default(uuid())
  code                    String        @unique // ACC-2018-0142
  legalName               String
  displayName             String
  industryId              String?
  industry                Industry?     @relation(fields: [industryId], references: [id])
  region                  String?
  tier                    AccountTier   @default(bronze)
  status                  AccountStatus @default(prospect)
  assignedRepId           String?
  assignedRep             StaffUser?    @relation(fields: [assignedRepId], references: [id])
  taxId                   String?
  preferredCurrency       Currency      @default(USD)
  defaultIncoterm         String?
  creditLimit             Decimal       @default(0) @db.Decimal(12, 2)
  creditOutstanding       Decimal       @default(0) @db.Decimal(12, 2)
  paymentTermsDays        Int           @default(30)
  avgDsoDays              Int           @default(0)
  requiresAddressApproval Boolean       @default(false)
  requiresRfqApprovalAbove Decimal?     @db.Decimal(12, 2)
  tags                    Json          @default("[]") // string[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  contacts    AccountContact[]
  addresses   AccountAddress[]
  rfqs        Rfq[]
  savedLists  SavedList[]
  activity    AccountActivity[]

  @@map("accounts")
}

model AccountContact {
  id                    String      @id @default(uuid())
  accountId             String
  account               Account     @relation(fields: [accountId], references: [id])
  email                 String      @unique
  passwordHash          String?
  ssoProvider           SsoProvider?
  firstName             String
  lastName              String
  phone                 String?
  role                  ContactRole @default(procurement)
  isDefaultBillingContact Boolean   @default(false)
  isActive              Boolean     @default(true)
  lastSignInAt          DateTime?
  failedSignInCount     Int         @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  passwordResetTokens PasswordResetToken[]
  submittedRfqs       Rfq[]               @relation("SubmittedBy")
  approvedAddresses   AccountAddress[]    @relation("ApprovedBy")
  savedListOwner      SavedList[]
  savedListComments   SavedListComment[]
  notifications       Notification[]

  @@index([accountId])
  @@map("account_contacts")
}

model AccountAddress {
  id              String      @id @default(uuid())
  accountId       String
  account         Account     @relation(fields: [accountId], references: [id])
  kind            AddressKind @default(ship_to)
  isDefaultShip   Boolean     @default(false)
  isDefaultBill   Boolean     @default(false)
  label           String
  attention       String?
  lines           Json        @default("[]") // string[]
  city            String
  region          String?
  postalCode      String?
  countryCode     String
  phone           String?
  email           String?
  deliveryNotes   String?
  taxIdOverride   String?
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      AccountContact? @relation("ApprovedBy", fields: [approvedById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  rfqsShipTo  Rfq[] @relation("ShipToAddress")
  rfqsBillTo  Rfq[] @relation("BillToAddress")

  @@index([accountId])
  @@map("account_addresses")
}

model StaffUser {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  passwordHash String?
  role        StaffRole @default(sales_rep)
  permissions Json      @default("{}") // fine-grained overrides
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignedAccounts Account[]
  assignedRfqs     Rfq[]     @relation("AssignedEngineer")
  repRfqs          Rfq[]     @relation("AssignedRep")
  mediaUploads     Media[]
  importJobs       ImportJob[]
  notifications    Notification[]
  blogPosts        BlogPost[]
  activityEntries  AccountActivity[]

  @@map("staff_users")
}

model AccountActivity {
  id         String            @id @default(uuid())
  accountId  String
  account    Account           @relation(fields: [accountId], references: [id])
  actorType  ActivityActorType
  actorId    String
  staffActor StaffUser?        @relation(fields: [actorId], references: [id], map: "activity_staff_fk")
  verb       String            // submitted_rfq, updated_credit_limit, commented, tier_upgraded
  payload    Json              @default("{}")
  createdAt  DateTime          @default(now())

  @@index([accountId])
  @@map("account_activity")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOGUE
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id                    String        @id @default(uuid())
  parentId              String?
  parent                Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children              Category[]    @relation("CategoryTree")
  slug                  String        @unique
  name                  String
  shortDescription      String?
  seoTitle              String?
  seoDescription        String?
  imageId               String?
  image                 Media?        @relation(fields: [imageId], references: [id])
  position              Int           @default(0)
  isPublished           Boolean       @default(false)
  defaultSpecTemplateId String?
  defaultSpecTemplate   SpecTemplate? @relation("CategoryDefaultTemplate", fields: [defaultSpecTemplateId], references: [id], onDelete: SetNull)

  // SEO OS — inline overrides (see packages/domain/src/seo/metadata.ts)
  canonicalUrl       String?
  robotsIndex        Boolean      @default(true)
  robotsFollow       Boolean      @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?     @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean      @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  products      Product[]
  navMenuItems  NavMenuItem[]

  @@map("categories")
}

model Brand {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  name                  String
  country               String?
  description           String?
  logoId                String?
  logo                  Media?   @relation("BrandLogo", fields: [logoId], references: [id])
  heroId                String?
  hero                  Media?   @relation("BrandHero", fields: [heroId], references: [id])
  isAuthorizedDistributor Boolean @default(false)
  seoTitle              String?
  seoDescription        String?
  isPublished           Boolean  @default(false)

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean      @default(true)
  robotsFollow       Boolean      @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?     @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean      @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  products     Product[]
  navMenuItems NavMenuItem[]

  @@map("brands")
}

model Industry {
  id             String  @id @default(uuid())
  slug           String  @unique
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  heroId         String?
  hero           Media?  @relation(fields: [heroId], references: [id])
  isPublished    Boolean @default(false)

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean      @default(true)
  robotsFollow       Boolean      @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?     @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean      @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  accounts     Account[]
  navMenuItems NavMenuItem[]

  @@map("industries")
}

model Product {
  id                String        @id @default(uuid())
  sku               String        @unique
  mpn               String?
  slug              String        @unique
  title             String
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?        @relation(fields: [brandId], references: [id])
  descriptionShort  String?
  descriptionLong   String?       // markdown/rich text
  listPrice         Decimal?      @db.Decimal(12, 2)
  listPriceCurrency Currency      @default(USD)
  unitOfMeasure     UnitOfMeasure @default(each)
  weightKg          Decimal?      @db.Decimal(8, 3)
  dimensionsMm      Json?         // {l, w, h}
  leadTimeDays      Int?
  warrantyMonths    Int?
  stockQty          Int           @default(0) // Aggregate stock across all warehouses; 0 = out of stock / lead-time-only
  stockWarehouse    String?       // Free-text warehouse identifier for the storefront pill (e.g. "Mumbai")
  countryOfOrigin   String?
  hsCode            String?
  status            ProductStatus @default(draft)
  supersededById    String?
  supersededBy      Product?      @relation("Supersession", fields: [supersededById], references: [id])
  supersedes        Product[]     @relation("Supersession")
  specTemplateId    String?
  specTemplate      SpecTemplate? @relation(fields: [specTemplateId], references: [id], onDelete: SetNull)
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean      @default(true)
  robotsFollow       Boolean      @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?     @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean      @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?
  // FTS column managed by raw SQL migration (Unsupported: tsvector)
  searchTsv          Unsupported("tsvector")?

  images          ProductImage[]
  specs           ProductSpec[]
  documents       ProductDocument[]
  crossReferences ProductCrossReference[]
  faqs            ProductFaq[]
  rfqLines        RfqLine[]
  savedListItems  SavedListItem[]
  orderLines      OrderLine[]
  navMenuItems    NavMenuItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id])
  position  Int     @default(0)
  alt       String?

  @@index([productId])
  @@map("product_images")
}

model ProductSpec {
  id              String             @id @default(uuid())
  productId       String
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  group           String             // "Hydraulic performance", "Mechanical", "Fluids", "Commercial"
  label           String
  value           String
  unit            String?
  position        Int                @default(0)
  isFilterable    Boolean            @default(false)
  templateFieldId String?
  templateField   SpecTemplateField? @relation(fields: [templateFieldId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([templateFieldId])
  @@map("product_specs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SPEC TEMPLATES — reusable typed schemas for product specs/key features.
// A category sets a default template; products attach to one. Each field has
// flags (isKeyFeature, isQuickSpec) for which storefront render zone it drives.
// ─────────────────────────────────────────────────────────────────────────────

model SpecTemplate {
  id          String              @id @default(uuid())
  slug        String              @unique
  name        String
  description String?
  position    Int                 @default(0)
  fields      SpecTemplateField[]
  products    Product[]
  categories  Category[]          @relation("CategoryDefaultTemplate")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("spec_templates")
}

model SpecTemplateField {
  id           String        @id @default(uuid())
  templateId   String
  template     SpecTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key          String        // immutable machine name once any ProductSpec references it
  label        String
  unit         String?
  dataType     SpecFieldType @default(text)
  options      Json?         // for dataType=select: ["A","B","C"]
  helpText     String?
  isRequired   Boolean       @default(false)
  isKeyFeature Boolean       @default(false)
  isQuickSpec  Boolean       @default(false)
  group        String?       // grouping for the tech-specs tab
  position     Int           @default(0)
  productSpecs ProductSpec[]

  @@unique([templateId, key])
  @@index([templateId])
  @@map("spec_template_fields")
}

model ProductDocument {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      DocumentKind
  title     String
  language  String       @default("en")
  mediaId   String
  media     Media        @relation(fields: [mediaId], references: [id])
  isGated   Boolean      @default(false)
  position  Int          @default(0)

  // PARTIAL UNIQUE INDEX (Postgres-only, not representable in Prisma schema):
  //   CREATE UNIQUE INDEX product_documents_one_datasheet_per_product
  //     ON product_documents ("productId") WHERE kind = 'datasheet';
  // Applied via migration `enforce_one_datasheet_per_product`.
  // Enforces "one datasheet per product" while still allowing multiple
  // STEP/IGES/manual documents. DO NOT run `prisma db push` against this
  // schema — it cannot represent the index and will silently drop it.
  @@index([productId])
  @@map("product_documents")
}

model ProductCrossReference {
  id               String                @id @default(uuid())
  productId        String
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorBrand  String
  competitorMpn    String
  compatibility    CrossRefCompatibility @default(direct)

  @@index([productId])
  @@map("product_cross_references")
}

// Admin-curated FAQ shown on the product detail page. No customer-submission
// flow — the previous moderated Q&A model was replaced because the field was
// always intended to be a static, per-product FAQ.
model ProductFaq {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  position  Int     @default(0)

  @@index([productId])
  @@map("product_faqs")
}

model Media {
  id               String    @id @default(uuid())
  kind             MediaKind
  mimeType         String
  originalFilename String
  storagePath      String    // S3/R2 key
  bytes            Int
  width            Int?
  height           Int?
  alt              String?
  caption          String?
  uploadedById     String?
  uploadedBy       StaffUser? @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime  @default(now())

  productImages     ProductImage[]
  productDocuments  ProductDocument[]
  categoryImages    Category[]
  brandLogos        Brand[]    @relation("BrandLogo")
  brandHeroes       Brand[]    @relation("BrandHero")
  industryHeroes    Industry[]
  rfqAttachments    RfqAttachment[]
  quotePdfs         Quote[]
  blogHeroes        BlogPost[]
  importJobSources  ImportJob[]
  navMenuItemPromos NavMenuItem[] @relation("NavMenuItemPromo")
  storeSettingsLogos StoreSettings[] @relation("StoreSettingsLogo")

  @@map("media")
}

// ─────────────────────────────────────────────────────────────────────────────
// RFQ → QUOTE → ORDER
// ─────────────────────────────────────────────────────────────────────────────

model Rfq {
  id                    String     @id @default(uuid())
  code                  String     @unique // RFQ-2026-0418
  accountId             String
  account               Account    @relation(fields: [accountId], references: [id])
  submittedByContactId  String?
  submittedBy           AccountContact? @relation("SubmittedBy", fields: [submittedByContactId], references: [id])
  subject               String?
  applicationContext    String?
  urgency               RfqUrgency @default(routine)
  requestedDeliveryDate DateTime?
  shipToAddressId       String?
  shipToAddress         AccountAddress? @relation("ShipToAddress", fields: [shipToAddressId], references: [id])
  billToAddressId       String?
  billToAddress         AccountAddress? @relation("BillToAddress", fields: [billToAddressId], references: [id])
  incoterm              String?
  currency              Currency   @default(USD)
  status                RfqStatus  @default(draft)
  assignedEngineerId    String?
  assignedEngineer      StaffUser? @relation("AssignedEngineer", fields: [assignedEngineerId], references: [id])
  assignedRepId         String?
  assignedRep           StaffUser? @relation("AssignedRep", fields: [assignedRepId], references: [id])
  internalNotes         String?
  customerMessage       String?
  submittedAt           DateTime?
  quoteSentAt           DateTime?
  acceptedAt            DateTime?
  quoteExpiresAt        DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  lines       RfqLine[]
  attachments RfqAttachment[]
  quotes      Quote[]
  orders      Order[]

  @@index([accountId, status, submittedAt])
  @@index([status])
  @@map("rfqs")
}

model RfqLine {
  id                  String   @id @default(uuid())
  rfqId               String
  rfq                 Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  requestedQty        Int
  customerTargetPrice Decimal? @db.Decimal(12, 2)
  shipFromWarehouse   String?  // free-text (e.g. "Mumbai", "Dubai") — no warehouse entity in scope
  engineerUnitPrice   Decimal? @db.Decimal(12, 2)
  engineerLeadTimeDays Int?
  appliedRuleIds      Json?    @default("[]") // future: pricing rule references
  engineerNotes       String?
  position            Int      @default(0)

  orderLines OrderLine[]

  @@index([rfqId])
  @@map("rfq_lines")
}

model RfqAttachment {
  id              String         @id @default(uuid())
  rfqId           String
  rfq             Rfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  mediaId         String
  media           Media          @relation(fields: [mediaId], references: [id])
  uploaderType    String?        // "contact" | "staff"
  uploaderId      String?
  createdAt       DateTime       @default(now())

  @@map("rfq_attachments")
}

model Quote {
  id              String    @id @default(uuid())
  code            String    @unique // Q-2026-0418
  rfqId           String
  rfq             Rfq       @relation(fields: [rfqId], references: [id])
  revision        Int       @default(1)
  subtotal        Decimal   @db.Decimal(12, 2)
  discountTotal   Decimal   @default(0) @db.Decimal(12, 2)
  shipping        Decimal   @default(0) @db.Decimal(12, 2)
  tax             Decimal   @default(0) @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  currency        Currency  @default(USD)
  termsPayment    String    @default("Net 30")
  termsValidityDays Int     @default(30)
  pdfMediaId      String?
  pdfMedia        Media?    @relation(fields: [pdfMediaId], references: [id])
  sentAt          DateTime?
  expiresAt       DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?

  orders Order[]

  @@index([rfqId])
  @@map("quotes")
}

model Order {
  id               String      @id @default(uuid())
  code             String      @unique // ORD-2026-0418
  quoteId          String?
  quote            Quote?      @relation(fields: [quoteId], references: [id])
  rfqId            String?
  rfq              Rfq?        @relation(fields: [rfqId], references: [id])
  accountId        String?
  status           OrderStatus @default(pending_credit_check)
  customerPoNumber String?
  subtotal         Decimal     @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  currency         Currency    @default(USD)
  placedAt         DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?

  lines     OrderLine[]
  shipments OrderShipment[]

  @@map("orders")
}

model OrderLine {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  rfqLineId         String?
  rfqLine           RfqLine? @relation(fields: [rfqLineId], references: [id])
  qty               Int
  unitPrice         Decimal  @db.Decimal(12, 2)
  shipFromWarehouse String?
  appliedRuleIds    Json?    @default("[]")

  @@index([orderId])
  @@map("order_lines")
}

model OrderShipment {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromWarehouse String?
  carrier       String?
  trackingNumber String?
  dispatchedAt  DateTime?
  deliveredAt   DateTime?

  @@map("order_shipments")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER SELF-SERVICE
// ─────────────────────────────────────────────────────────────────────────────

model SavedList {
  id               String               @id @default(uuid())
  accountId        String
  account          Account              @relation(fields: [accountId], references: [id])
  ownerContactId   String?
  owner            AccountContact?      @relation(fields: [ownerContactId], references: [id])
  name             String
  description      String?
  visibility       SavedListVisibility  @default(team)
  reorderCadence   ReorderCadence?
  nextReorderDueAt DateTime?
  autoRfq          Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  items    SavedListItem[]
  comments SavedListComment[]

  @@index([accountId])
  @@map("saved_lists")
}

model SavedListItem {
  id            String    @id @default(uuid())
  savedListId   String
  savedList     SavedList @relation(fields: [savedListId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  quantity      Int       @default(1)
  note          String?
  isSuperseded  Boolean   @default(false)
  deletedAt     DateTime? // soft delete — undo within 30 days
  position      Int       @default(0)

  @@index([savedListId])
  @@map("saved_list_items")
}

model SavedListComment {
  id          String         @id @default(uuid())
  savedListId String
  savedList   SavedList      @relation(fields: [savedListId], references: [id], onDelete: Cascade)
  actorType   String         // "contact" | "staff"
  contactId   String?
  contact     AccountContact? @relation(fields: [contactId], references: [id])
  body        String
  createdAt   DateTime       @default(now())

  @@map("saved_list_comments")
}

model PasswordResetToken {
  id          String         @id @default(uuid())
  contactId   String
  contact     AccountContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tokenHash   String         @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime       @default(now())

  @@map("password_reset_tokens")
}

model Notification {
  id            String                    @id @default(uuid())
  recipientKind NotificationRecipientKind
  contactId     String?
  contact       AccountContact?           @relation(fields: [contactId], references: [id])
  staffId       String?
  staff         StaffUser?                @relation(fields: [staffId], references: [id])
  kind          NotificationKind
  payload       Json                      @default("{}")
  readAt        DateTime?
  createdAt     DateTime                  @default(now())

  @@index([contactId, readAt])
  @@index([staffId, readAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTENT & SEO
// ─────────────────────────────────────────────────────────────────────────────

model CmsPage {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  body        String    // rich text / HTML
  seoTitle    String?
  seoDescription String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean      @default(true)
  robotsFollow       Boolean      @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?     @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean      @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  navMenuItems NavMenuItem[]

  @@map("cms_pages")
}

model BlogPost {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  excerpt        String?
  body           String    // rich text
  heroId         String?
  hero           Media?    @relation(fields: [heroId], references: [id])
  authorStaffId  String?
  author         StaffUser? @relation(fields: [authorStaffId], references: [id])
  tags           Json      @default("[]") // string[]
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  isPublished    Boolean   @default(false)

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean      @default(true)
  robotsFollow       Boolean      @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?     @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean      @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  @@map("blog_posts")
}

model Redirect {
  id          String    @id @default(uuid())
  fromPath    String    @unique
  toPath      String
  statusCode  Int       @default(301)
  createdAt   DateTime  @default(now())
  hits        Int       @default(0)
  lastHitAt   DateTime?
  isActive    Boolean   @default(true)
  createdById String?
  notes       String?

  @@index([isActive])
  @@map("redirects")
}

// ─────────────────────────────────────────────────────────────────────────────
// NAVIGATION CMS
// ─────────────────────────────────────────────────────────────────────────────

model NavMenu {
  id          String        @id @default(uuid())
  slug        String        @unique
  name        String
  location    MenuLocation  @unique
  description String?
  isPublished Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items NavMenuItem[]

  @@map("nav_menus")
}

model NavMenuItem {
  id           String        @id @default(uuid())
  menuId       String
  menu         NavMenu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       NavMenuItem?  @relation("NavMenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavMenuItem[] @relation("NavMenuItemTree")
  position     Int           @default(0)

  label        String
  iconName     String?
  badge        String?
  description  String?

  linkType     MenuLinkType  @default(none)
  customUrl    String?
  openInNewTab Boolean       @default(false)

  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId      String?
  brand        Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  industryId   String?
  industry     Industry?     @relation(fields: [industryId], references: [id], onDelete: SetNull)
  cmsPageId    String?
  cmsPage      CmsPage?      @relation(fields: [cmsPageId], references: [id], onDelete: SetNull)
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  promoImageId String?
  promoImage   Media?        @relation("NavMenuItemPromo", fields: [promoImageId], references: [id], onDelete: SetNull)
  promoHeading String?
  promoBody    String?
  promoLinkUrl String?

  isVisible    Boolean       @default(true)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([menuId, parentId, position])
  @@map("nav_menu_items")
}

model SeoSetting {
  id                          String   @id @default(uuid())
  defaultMetaTitleTemplate    String?
  defaultMetaDescription      String?
  ogDefaultImageId            String?
  robotsTxt                   String?
  sitemapSettings             Json     @default("{}")
  organizationJsonLd          Json?
  websiteJsonLd               Json?
  sitemapMaxUrls              Int      @default(45000)
  robotsTxtAutoAppendSitemap  Boolean  @default(true)

  @@map("seo_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// BULK IMPORT
// ─────────────────────────────────────────────────────────────────────────────

model ImportJob {
  id                 String       @id @default(uuid())
  code               String       @unique // IMPORT-2026-0042
  entity             ImportEntity
  sourceMediaId      String?
  sourceMedia        Media?       @relation(fields: [sourceMediaId], references: [id])
  columnMapping      Json         @default("{}") // {csv_col: indus_field}
  options            Json         @default("{}") // {skip_errors, publish_new, ...}
  status             ImportStatus @default(uploaded)
  totalRows          Int          @default(0)
  rowsToCreate       Int          @default(0)
  rowsToUpdate       Int          @default(0)
  rowsWithWarnings   Int          @default(0)
  rowsWithErrors     Int          @default(0)
  rollbackSnapshotId String?
  startedById        String?
  startedBy          StaffUser?   @relation(fields: [startedById], references: [id])
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime     @default(now())

  rows ImportJobRow[]

  @@map("import_jobs")
}

model ImportJobRow {
  id          String           @id @default(uuid())
  importJobId String
  importJob   ImportJob        @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber   Int
  rawData     Json
  mappedData  Json?
  outcome     ImportRowOutcome?
  entityId    String?
  messages    Json             @default("[]") // string[]

  @@index([importJobId])
  @@map("import_job_rows")
}

// ─────────────────────────────────────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────────────────────────────────────

model StoreSettings {
  id                  String   @id @default(uuid())
  name                String   @default("Indus Hydraulics")
  supportEmail        String?
  defaultCurrency     Currency @default(USD)
  defaultIncoterm     String?
  defaultPaymentTerms Int      @default(30)

  // Brand identity (rendered in storefront header / footer)
  tagline              String?
  logoMediaId          String?
  logoMedia            Media?   @relation("StoreSettingsLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  certificationLine    String?

  // Public contact info (single location for now; multi-location is a deferred follow-up)
  contactPhone         String?
  contactEmail         String?
  contactHours         String?
  contactLocationLabel String?

  updatedAt            DateTime @updatedAt

  @@map("store_settings")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  kind      String   @unique // rfq_ack, quote_sent, password_reset, order_shipped
  subject   String
  bodyHtml  String
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// SEO OPERATING SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

// Editable prompt templates the AI Suggest layer uses. The systemPrompt is
// designed for Anthropic prompt caching (large stable prefix).
model AiPromptTemplate {
  id           String        @id @default(uuid())
  kind         AiPromptKind
  entityType   SeoEntityType
  name         String
  systemPrompt String
  userTemplate String
  model        String        @default("claude-haiku-4-5")
  maxTokens    Int           @default(400)
  isActive     Boolean       @default(true)
  updatedAt    DateTime      @updatedAt

  @@unique([kind, entityType, isActive])
  @@map("ai_prompt_templates")
}

// Every AI generation, regardless of accept/reject. Drives the diff-and-approve
// workflow + audits cost.
model AiSuggestion {
  id            String              @id @default(uuid())
  entityType    SeoEntityType
  entityId      String
  field         String              // e.g. "metaTitle", "metaDescription", "altText:<imageId>"
  templateId    String?
  model         String
  inputContext  Json
  output        String
  status        AiSuggestionStatus  @default(pending)
  costUsdMicros Int                 @default(0)
  cacheHitRatio Float?
  inputTokens   Int?
  outputTokens  Int?
  createdById   String?
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?

  @@index([entityType, entityId, field, createdAt])
  @@map("ai_suggestions")
}

model AiUsageQuota {
  id                   String   @id @default(uuid())
  staffUserId          String   @unique
  monthlyUsdCapMicros  Int      @default(50000000) // $50/month default
  spentThisMonthMicros Int      @default(0)
  resetAt              DateTime

  @@map("ai_usage_quotas")
}

// Cached health score per entity. Recomputed on save + nightly.
model SeoHealthScore {
  id         String        @id @default(uuid())
  entityType SeoEntityType
  entityId   String
  score      Int           // 0..100
  breakdown  Json          // {checkId: {pass, weight, message}}
  computedAt DateTime      @default(now())

  @@unique([entityType, entityId])
  @@map("seo_health_scores")
}

// Search subsystem
model SearchSynonym {
  id       String  @id @default(uuid())
  group    String
  term     String
  isActive Boolean @default(true)

  @@unique([group, term])
  @@index([term])
  @@map("search_synonyms")
}

model SearchRedirect {
  id        String  @id @default(uuid())
  query     String  @unique // normalized lowercase
  targetUrl String
  isActive  Boolean @default(true)

  @@map("search_redirects")
}

model SearchBoost {
  id         String        @id @default(uuid())
  entityType SeoEntityType
  entityId   String
  boost      Float
  expiresAt  DateTime?

  @@unique([entityType, entityId])
  @@map("search_boosts")
}

model SearchQueryLog {
  id           String    @id @default(uuid())
  query        String
  normalized   String
  resultsCount Int
  clickedSku   String?
  clickedAt    DateTime?
  sessionId    String?
  userId       String?
  createdAt    DateTime  @default(now())

  @@index([normalized, createdAt])
  @@index([resultsCount, createdAt])
  @@map("search_query_logs")
}

// Audit trail for SEO writes — supports the revert UI.
model SeoAuditLog {
  id         String   @id @default(uuid())
  entityType String   // includes "global:robots", "global:sitemap"
  entityId   String?
  field      String
  before     Json?
  after      Json?
  actorId    String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("seo_audit_logs")
}

model NotFoundLog {
  id                 String    @id @default(uuid())
  path               String    @unique
  referer            String?
  userAgent          String?
  hits               Int       @default(1)
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  resolvedRedirectId String?

  @@index([hits])
  @@map("not_found_logs")
}

// Phase 2 — Google Search Console daily metrics
model GscMetricDaily {
  id          String   @id @default(uuid())
  url         String
  date        DateTime @db.Date
  query       String?  // null row = page-level totals
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  @@unique([url, date, query])
  @@index([url, date])
  @@map("gsc_metric_daily")
}

// Phase 3 — link-graph crawler
model CrawlRun {
  id           String         @id @default(uuid())
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  pagesCrawled Int            @default(0)
  edges        CrawlEdge[]
  findings     CrawlFinding[]

  @@map("crawl_runs")
}

model CrawlEdge {
  id         String   @id @default(uuid())
  runId      String
  fromUrl    String
  toUrl      String
  status     Int
  isInternal Boolean
  rel        String?
  run        CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, toUrl])
  @@map("crawl_edges")
}

model CrawlFinding {
  id     String   @id @default(uuid())
  runId  String
  kind   String   // orphan | broken | redirect_chain | deep | dup_canonical
  url    String
  detail Json
  run    CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, kind])
  @@map("crawl_findings")
}
