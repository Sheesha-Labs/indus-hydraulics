// Audit trail for SEO writes — supports the revert UI.
model SeoAuditLog {
  id         String   @id @default(uuid())
  entityType String // includes "global:robots", "global:sitemap"
  entityId   String?
  field      String
  before     Json?
  after      Json?
  actorId    String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("seo_audit_logs")
