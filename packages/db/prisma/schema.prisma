// Indus Hydraulics — Prisma Schema
// Canonical source of truth for all database entities.
// Excludes: pricing_rule, pricing_evaluation_log, inventory_*, purchase_order_* (out of scope)

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

