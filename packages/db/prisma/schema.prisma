// CUSTOMER SELF-SERVICE
// ─────────────────────────────────────────────────────────────────────────────

model SavedList {
  id               String              @id @default(uuid())
  accountId        String
  account          Account             @relation(fields: [accountId], references: [id])
  ownerContactId   String?
  owner            AccountContact?     @relation(fields: [ownerContactId], references: [id])
  name             String
  description      String?
  visibility       SavedListVisibility @default(team)
  reorderCadence   ReorderCadence?
  nextReorderDueAt DateTime?
  autoRfq          Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  items    SavedListItem[]
  comments SavedListComment[]

  @@index([accountId])
  @@map("saved_lists")
}

model SavedListItem {
  id           String    @id @default(uuid())
  savedListId  String
  savedList    SavedList @relation(fields: [savedListId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  quantity     Int       @default(1)
  note         String?
  isSuperseded Boolean   @default(false)
  deletedAt    DateTime? // soft delete — undo within 30 days
  position     Int       @default(0)

  @@index([savedListId])
  @@map("saved_list_items")
}

model SavedListComment {
  id          String          @id @default(uuid())
  savedListId String
  savedList   SavedList       @relation(fields: [savedListId], references: [id], onDelete: Cascade)
  actorType   String // "contact" | "staff"
  contactId   String?
  contact     AccountContact? @relation(fields: [contactId], references: [id])
  body        String
  createdAt   DateTime        @default(now())

  @@map("saved_list_comments")
}

model PasswordResetToken {
  id          String         @id @default(uuid())
  contactId   String
  contact     AccountContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tokenHash   String         @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime       @default(now())

  @@map("password_reset_tokens")
}

model Notification {
  id            String                    @id @default(uuid())
  recipientKind NotificationRecipientKind
  contactId     String?
  contact       AccountContact?           @relation(fields: [contactId], references: [id])
  staffId       String?
  staff         StaffUser?                @relation(fields: [staffId], references: [id])
  kind          NotificationKind
  payload       Json                      @default("{}")
  readAt        DateTime?
  createdAt     DateTime                  @default(now())

  @@index([contactId, readAt])
  @@index([staffId, readAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTENT & SEO
// ─────────────────────────────────────────────────────────────────────────────

model CmsPage {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  body           String // rich text / HTML
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean     @default(true)
  robotsFollow       Boolean     @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?    @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean     @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  navMenuItems NavMenuItem[]

  @@map("cms_pages")
}

model BlogPost {
  id             String     @id @default(uuid())
  slug           String     @unique
  title          String
  excerpt        String?
  body           String // rich text
  heroId         String?
  hero           Media?     @relation(fields: [heroId], references: [id])
  authorStaffId  String?
  author         StaffUser? @relation(fields: [authorStaffId], references: [id])
  tags           Json       @default("[]") // string[]
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?

  // `isPublished` is retained rather than replaced. `status` supersedes it and
  // is backfilled to match, but both stay in sync until every read site has
  // moved — dropping the boolean in the same change would break the storefront
  // and the admin list on deploy.
  isPublished Boolean        @default(false)
  status      BlogPostStatus @default(draft)

  /// Typed block array validated by BlogBlocksSchema in @indus/domain.
  /// `body` remains the fallback while posts migrate across.
  bodyBlocks     Json     @default("[]")
  readingMinutes Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Soft delete. A trashed post also has `isPublished` forced false, which is
  /// what every storefront read already filters on — so trashing removes it
  /// from the site without a second gate on every query. Restoring returns it
  /// to draft rather than to live: going back up should be deliberate.
  deletedAt DateTime?

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  /// Public byline. Falls back to `author` (the staff user who saved the post)
  /// until every post has one, so nothing renders bylineless in between.
  blogAuthorId String?
  blogAuthor   BlogAuthor? @relation(fields: [blogAuthorId], references: [id])

  /// Standards content carries pressure ratings and clause references — a
  /// named reviewer makes "who checked this" answerable rather than assumed.
  reviewedById String?
  reviewedBy   StaffUser? @relation("BlogPostReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  products         BlogPostProduct[]
  linkedCategories BlogPostCategory[]

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean                  @default(true)
  robotsFollow       Boolean                  @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?                 @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean                  @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?
  // FTS column managed by raw SQL migration (Unsupported: tsvector).
  // STORED, weighted A→B→C across title / excerpt / body.
  searchTsv          Unsupported("tsvector")?

  @@index([deletedAt, status])
  @@map("blog_posts")
}

/// Blog taxonomy. Replaces `tags[0]`-as-category: a category with its own row
/// gets its own URL, and the hub page at /blog/c/[slug] is what accumulates
/// internal links and ranks for a topic. A JSON string cannot do that.
model BlogCategory {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  /// Intro copy rendered above the article list on the hub page.
  heroCopy    String?
  position    Int     @default(0)
  isPublished Boolean @default(true)
  imageId     String?
  image       Media?  @relation("BlogCategoryImage", fields: [imageId], references: [id])

  // SEO OS — inline overrides
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  robotsIndex        Boolean     @default(true)
  robotsFollow       Boolean     @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?    @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean     @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]

  @@index([isPublished, position])
  @@map("blog_categories")
}

/// Public author profile. Deliberately not extra columns on StaffUser: an auth
/// table should not carry marketing copy, and a byline is not a login — an
/// outside contributor needs a profile without an admin account, and a
/// warehouse user should not become a public page merely by existing.
model BlogAuthor {
  id              String     @id @default(uuid())
  slug            String     @unique
  name            String
  jobTitle        String?
  bio             String?
  /// Free text, e.g. "BEng Mechanical · IWCF Level 4". Feeds Person JSON-LD
  /// `hasCredential`, which is much of the reason author pages are worth building.
  credentials     String?
  yearsExperience Int?
  avatarMediaId   String?
  avatar          Media?     @relation("BlogAuthorAvatar", fields: [avatarMediaId], references: [id])
  linkedinUrl     String?
  /// Set when the author is also a staff user. Optional in both directions.
  staffUserId     String?
  staffUser       StaffUser? @relation("BlogAuthorStaffUser", fields: [staffUserId], references: [id])
  isPublished     Boolean    @default(true)
  position        Int        @default(0)

  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  robotsIndex        Boolean     @default(true)
  robotsFollow       Boolean     @default(true)
  ogImageMediaId     String?
  sitemapPriority    Decimal?    @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean     @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]

  @@index([isPublished, position])
  @@map("blog_authors")
}

/// Article → product links, mirrored out of `product_embed` blocks. Stored
/// relationally so a product page can ask "which articles mention me" without
/// scanning every JSON body — that reverse direction is the loop that makes
/// the blog pay.
model BlogPostProduct {
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@id([postId, productId])
  @@index([productId])
  @@map("blog_post_products")
}

/// Article → catalogue category links. Distinct from `BlogPost.categoryId`,
/// which is the post's own blog category; this points at /c/[slug].
model BlogPostCategory {
  postId     String
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@id([postId, categoryId])
  @@index([categoryId])
  @@map("blog_post_categories")
}

model Redirect {
  id          String    @id @default(uuid())
  fromPath    String    @unique
  toPath      String
  statusCode  Int       @default(301)
  createdAt   DateTime  @default(now())
  hits        Int       @default(0)
  lastHitAt   DateTime?
  isActive    Boolean   @default(true)
  createdById String?
  notes       String?

  @@index([isActive])
  @@map("redirects")
}

