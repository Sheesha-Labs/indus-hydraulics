  messages    Json              @default("[]") // string[]

  @@index([importJobId])
  @@map("import_job_rows")
}

// ─────────────────────────────────────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────────────────────────────────────

model StoreSettings {
  id                  String   @id @default(uuid())
  name                String   @default("Indus Hydraulics")
  supportEmail        String?
  defaultCurrency     Currency @default(USD)
  defaultIncoterm     String?
  defaultPaymentTerms Int      @default(30)

  // Brand identity (rendered in storefront header / footer)
  tagline           String?
  logoMediaId       String?
  logoMedia         Media?  @relation("StoreSettingsLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  certificationLine String?

  // How the header logo relates to the typeset "Indus Hydraulics" wordmark:
  // "mark_and_name" draws it beside the type, "logo_only" replaces the type.
  // The header cannot tell a monogram from a finished lockup by looking at the
  // bytes, so the operator says which. See LOGO_STYLES in lib/brand-identity.ts.
  logoStyle String @default("mark_and_name")

  // The footer sits on the navy surface, so the file that works there is
  // normally the reversed (light) variant of the header artwork. Its own
  // column rather than a reuse of logoMediaId, which would force a choice of
  // which of the two surfaces to get right. Null keeps the typeset wordmark —
  // deliberately NOT falling back to logoMedia, because a dark lockup on the
  // dark footer reads as a broken image where the wordmark always reads.
  footerLogoMediaId String?
  footerLogoMedia   Media?  @relation("StoreSettingsFooterLogo", fields: [footerLogoMediaId], references: [id], onDelete: SetNull)

  // The browser-tab icon. Null falls back to the bundled app/favicon.ico.
  faviconMediaId String?
  faviconMedia   Media?  @relation("StoreSettingsFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)

  // The square mark a search engine draws beside the result and in a knowledge
  // panel — read from rel="icon" sizes="192x192", apple-touch-icon and the
  // Organization JSON-LD `logo`. Its own column rather than a reuse of the
  // favicon: a file authored to survive 16px in a tab strip is normally cruder
  // than the one that should stand for the brand at ~24px in a result row and
  // much larger in a panel. Null falls back favicon → logo, so this is
  // additive for an operator who never touches it.
  searchLogoMediaId String?
  searchLogoMedia   Media?  @relation("StoreSettingsSearchLogo", fields: [searchLogoMediaId], references: [id], onDelete: SetNull)

  // Public contact info (single location for now; multi-location is a deferred follow-up)
  contactPhone         String?
  contactEmail         String?
  contactHours         String?
  contactLocationLabel String?

  // Legal entity (rendered on every quote PDF + email footer)
  legalName              String? // "Indus Hydraulic Power Trading LLC"
  vatTrn                 String? // "100548997400003"
  registeredAddressLines Json?   @default("[]") // string[] of address lines
  registeredCity         String?
  registeredCountry      String?
  registeredPoBox        String?
  registeredCountryCode  String? // ISO-3166 alpha-2 (e.g. "AE") — drives VAT logic

  // Quote signature block (e.g. "Krishan Bhatia / Managing Director / +971 …")
  signatureName  String?
  signatureTitle String?
  signaturePhone String?
  signatureEmail String?

  // Outbound email config
  quoteFromEmail      String? // e.g. "sales@indushydraulics.me" — used as From + Reply-To
  quoteFromName       String? // friendly display name shown in inbox
  internalAlertEmails Json?   @default("[]") // string[] — recipients of new-RFQ alert

  // Quote defaults (engineer can override per quote)
  defaultVatRatePct        Decimal? @db.Decimal(5, 2) // e.g. 5.00 for UAE; nullable = use country rule
  defaultQuoteValidityDays Int      @default(30)
  defaultQuoteNotes        String?
  defaultQuoteTerms        String?
  defaultQuoteDisclaimer   String?

  // Bank details rendered in PDF footer (all optional — render block only if any set)
  bankAccountName String?
  bankAccountNo   String?
  bankName        String?
  bankBranch      String?
  bankIban        String?
  bankSwift       String?

  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// HOMEPAGE HERO CAROUSEL
//
// Ordered list of slides rendered on the storefront homepage hero (right-side
// visual, replacing the static "exploded view" placeholder). Each slide
// references a Media row in the existing public images bucket. The storefront
// loader uses unstable_cache + revalidateTag('homepage-hero') so admin
// mutations invalidate the cached query immediately.
//
// `position` is server-managed (admin reorder shuffles the values). `isPublished`
// lets editors stage a slide without making it live; the storefront filters on
// it. `alt` overrides the underlying Media.alt so the same Media asset can be
// reused in other contexts with different alt text.
// ─────────────────────────────────────────────────────────────────────────────

model HomepageHeroSlide {
  id          String   @id @default(uuid())
  mediaId     String
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position    Int      @default(0)
  alt         String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
  @@index([isPublished, position])
  @@map("homepage_hero_slides")
}

// Audit log of every transactional email sent. Used for support, debugging,
// and re-sending. Body stored verbatim so we can show the customer exactly
// what they received.
model SentEmail {
  id            String    @id @default(uuid())
  kind          String // rfq_confirmation | rfq_internal_alert | quote_sent | quote_accepted_ack | …
  toEmails      Json // string[]
  ccEmails      Json? // string[]
  bccEmails     Json? // string[]
  fromEmail     String
  replyTo       String?
  subject       String
  bodyHtml      String
  providerId    String? // Resend message id (when sent successfully)
  status        String // queued | sent | failed | sandboxed | dead_letter
  error         String?
  rfqId         String?
  rfq           Rfq?      @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  attemptedAt   DateTime  @default(now())
  sentAt        DateTime?
  // Retry queue: hourly Inngest cron picks up `failed` rows whose
  // `payload` survived the first send and retries up to 3× with
  // exponential backoff. `dead_letter` after the 3rd failure.
  // `payload` is the serialisable subset of SendEmailInput minus
  // attachments — emails with attachments are never retried because
  // the buffer isn't recoverable from the audit row alone.
  retryCount    Int       @default(0)
  lastAttemptAt DateTime?
  payload       Json?

  @@index([kind, attemptedAt])
  @@index([rfqId])
  @@index([quoteId])
  @@index([status, retryCount, lastAttemptAt])
  @@map("sent_emails")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  kind      String   @unique // rfq_ack, quote_sent, password_reset, order_shipped
  subject   String
  bodyHtml  String
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// SEO OPERATING SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

// Editable prompt templates the AI Suggest layer uses. The systemPrompt is
// designed for Anthropic prompt caching (large stable prefix).
model AiPromptTemplate {
  id           String        @id @default(uuid())
  kind         AiPromptKind
  entityType   SeoEntityType
  name         String
  systemPrompt String
  userTemplate String
  model        String        @default("claude-haiku-4-5")
  maxTokens    Int           @default(400)
  isActive     Boolean       @default(true)
  updatedAt    DateTime      @updatedAt

  @@unique([kind, entityType, isActive])
  @@map("ai_prompt_templates")
}

// Every AI generation, regardless of accept/reject. Drives the diff-and-approve
// workflow + audits cost.
model AiSuggestion {
  id            String             @id @default(uuid())
  entityType    SeoEntityType
  entityId      String
  field         String // e.g. "metaTitle", "metaDescription", "altText:<imageId>"
  templateId    String?
  model         String
  inputContext  Json
  output        String
  status        AiSuggestionStatus @default(pending)
  costUsdMicros Int                @default(0)
  cacheHitRatio Float?
  inputTokens   Int?
  outputTokens  Int?
  createdById   String?
  createdAt     DateTime           @default(now())
  reviewedAt    DateTime?

  @@index([entityType, entityId, field, createdAt])
  @@map("ai_suggestions")
}

model AiUsageQuota {
  id                   String   @id @default(uuid())
  staffUserId          String   @unique
  monthlyUsdCapMicros  Int      @default(50000000) // $50/month default
  spentThisMonthMicros Int      @default(0)
  resetAt              DateTime

  @@map("ai_usage_quotas")
}

// Cached health score per entity. Recomputed on save + nightly.
model SeoHealthScore {
  id         String        @id @default(uuid())
  entityType SeoEntityType
  entityId   String
  score      Int // 0..100
  breakdown  Json // {checkId: {pass, weight, message}}
  computedAt DateTime      @default(now())

  @@unique([entityType, entityId])
  @@map("seo_health_scores")
}

// Search subsystem
model SearchSynonym {
  id       String  @id @default(uuid())
  group    String
  term     String
  isActive Boolean @default(true)

  @@unique([group, term])
  @@index([term])
  @@map("search_synonyms")
}

model SearchRedirect {
  id        String  @id @default(uuid())
  query     String  @unique // normalized lowercase
  targetUrl String
  isActive  Boolean @default(true)

  @@map("search_redirects")
}

model SearchBoost {
  id         String        @id @default(uuid())
  entityType SeoEntityType
  entityId   String
  boost      Float
  expiresAt  DateTime?

  @@unique([entityType, entityId])
  @@map("search_boosts")
}

model SearchQueryLog {
  id           String    @id @default(uuid())
  query        String
  normalized   String
  resultsCount Int
  clickedSku   String?
  clickedAt    DateTime?
  sessionId    String?
  userId       String?
  createdAt    DateTime  @default(now())

  @@index([normalized, createdAt])
  @@index([resultsCount, createdAt])
  @@map("search_query_logs")
