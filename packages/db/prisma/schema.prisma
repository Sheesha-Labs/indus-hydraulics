// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY & ACCOUNTS
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                       String        @id @default(uuid())
  code                     String        @unique // ACC-2018-0142
  legalName                String
  displayName              String
  industryId               String?
  industry                 Industry?     @relation(fields: [industryId], references: [id])
  region                   String?
  tier                     AccountTier   @default(bronze)
  status                   AccountStatus @default(prospect)
  assignedRepId            String?
  assignedRep              StaffUser?    @relation(fields: [assignedRepId], references: [id])
  taxId                    String?
  preferredCurrency        Currency      @default(USD)
  defaultIncoterm          String?
  creditLimit              Decimal       @default(0) @db.Decimal(12, 2)
  creditOutstanding        Decimal       @default(0) @db.Decimal(12, 2)
  paymentTermsDays         Int           @default(30)
  avgDsoDays               Int           @default(0)
  requiresAddressApproval  Boolean       @default(false)
  requiresRfqApprovalAbove Decimal?      @db.Decimal(12, 2)
  tags                     Json          @default("[]") // string[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  contacts   AccountContact[]
  addresses  AccountAddress[]
  rfqs       Rfq[]
  savedLists SavedList[]
  activity   AccountActivity[]

  @@map("accounts")
}

model AccountContact {
  id                      String       @id @default(uuid())
  accountId               String
  account                 Account      @relation(fields: [accountId], references: [id])
  email                   String       @unique
  passwordHash            String?
  ssoProvider             SsoProvider?
  firstName               String
  lastName                String
  phone                   String?
  role                    ContactRole  @default(procurement)
  isDefaultBillingContact Boolean      @default(false)
  isActive                Boolean      @default(true)
  lastSignInAt            DateTime?
  failedSignInCount       Int          @default(0)
  lockedUntil             DateTime?
  // In-flight email-change verification. The user requests a change, we
  // email a token to the proposed new address, the user clicks the link
  // and the swap completes. Only one pending change at a time per contact;
  // requesting a new one overwrites these three fields.
  pendingEmailNew         String?
  pendingEmailTokenHash   String?
  pendingEmailExpiresAt   DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  passwordResetTokens PasswordResetToken[]
  submittedRfqs       Rfq[]                @relation("SubmittedBy")
  approvedAddresses   AccountAddress[]     @relation("ApprovedBy")
  savedListOwner      SavedList[]
  savedListComments   SavedListComment[]
  notifications       Notification[]

  @@index([accountId])
  @@map("account_contacts")
}

model AccountAddress {
  id            String          @id @default(uuid())
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id])
  kind          AddressKind     @default(ship_to)
  isDefaultShip Boolean         @default(false)
  isDefaultBill Boolean         @default(false)
  label         String
  attention     String?
  lines         Json            @default("[]") // string[]
  city          String
  region        String?
  postalCode    String?
  countryCode   String
  phone         String?
  email         String?
  deliveryNotes String?
  taxIdOverride String?
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    AccountContact? @relation("ApprovedBy", fields: [approvedById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  rfqsShipTo Rfq[] @relation("ShipToAddress")
  rfqsBillTo Rfq[] @relation("BillToAddress")

  @@index([accountId])
  @@map("account_addresses")
}

model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         StaffRole @default(sales_rep)
  permissions  Json      @default("{}") // fine-grained overrides
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Brute-force protection, mirroring AccountContact. Staff had none: the
  // sign-in form accepted unlimited password guesses. Tolerable while it sat
  // on an obscure admin-only host; not once /admin is on the public domain.
  lastSignInAt      DateTime?
  failedSignInCount Int       @default(0)
  lockedUntil       DateTime?

  assignedAccounts  Account[]
  assignedRfqs      Rfq[]             @relation("AssignedEngineer")
  repRfqs           Rfq[]             @relation("AssignedRep")
  mediaUploads      Media[]
  importJobs        ImportJob[]
  notifications     Notification[]
  blogPosts         BlogPost[]
  reviewedBlogPosts BlogPost[]        @relation("BlogPostReviewer")
  blogAuthorProfile BlogAuthor[]      @relation("BlogAuthorStaffUser")
  sentInvitations   StaffInvitation[] @relation("StaffInvitationInvitedBy")

  @@map("staff_users")
}

model AccountActivity {
  id        String            @id @default(uuid())
  accountId String
  account   Account           @relation(fields: [accountId], references: [id])
  // Polymorphic actor: actorType in ('contact'|'staff'|'system') tells you
  // which table actorId references. We deliberately do NOT enforce this as a
  // Postgres FK because Postgres doesn't support conditional FKs and a hard
  // StaffUser FK breaks every customer-initiated activity row (the previous
  // `staffActor StaffUser? @relation(map: "activity_staff_fk")` made
  // submitRfq fail with a constraint violation on every contact submission).
  // Resolve actorId in app code based on actorType.
  actorType ActivityActorType
  actorId   String
  verb      String // submitted_rfq, updated_credit_limit, commented, tier_upgraded
  payload   Json              @default("{}")
  createdAt DateTime          @default(now())

  @@index([accountId])
  @@index([actorType, actorId])
  @@map("account_activity")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOGUE
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id                    String        @id @default(uuid())
  parentId              String?
  parent                Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children              Category[]    @relation("CategoryTree")
  slug                  String        @unique
  name                  String
  shortDescription      String?
  seoTitle              String?
  seoDescription        String?
  imageId               String?
  image                 Media?        @relation(fields: [imageId], references: [id])
  position              Int           @default(0)
  isPublished           Boolean       @default(false)
  defaultSpecTemplateId String?
  defaultSpecTemplate   SpecTemplate? @relation("CategoryDefaultTemplate", fields: [defaultSpecTemplateId], references: [id], onDelete: SetNull)

  // SEO OS — inline overrides (see packages/domain/src/seo/metadata.ts)
  canonicalUrl       String?
  robotsIndex        Boolean     @default(true)
  robotsFollow       Boolean     @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?    @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean     @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  products     Product[]
  navMenuItems NavMenuItem[]
  blogPosts    BlogPostCategory[]

  @@map("categories")
}

model Brand {
  id                      String  @id @default(uuid())
  slug                    String  @unique
  name                    String
  country                 String?
  description             String?
  logoId                  String?
  logo                    Media?  @relation("BrandLogo", fields: [logoId], references: [id])
  heroId                  String?
  hero                    Media?  @relation("BrandHero", fields: [heroId], references: [id])
  isAuthorizedDistributor Boolean @default(false)
  seoTitle                String?
  seoDescription          String?
  isPublished             Boolean @default(false)
  // Display order on the listing + nav lists. 0 = default.
  position                Int     @default(0)

  // Specialist card on the storefront brand page. All fields optional
  // so brands can ship without an account-manager assignment.
  accountManagerName     String?
  accountManagerTitle    String?
  accountManagerYearsExp String?
  accountManagerInitials String?

  // Stats row — replaces the previously hardcoded "740 kW · Reliance
  // Steel · Jamnagar" and "Partner since 1998" placeholders.
  fastestLeadTime       String?
  largestInstallValue   String?
  largestInstallContext String?
  partnerSince          Int?

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean     @default(true)
  robotsFollow       Boolean     @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?    @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean     @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  products     Product[]
  navMenuItems NavMenuItem[]
  caseStudies  BrandCaseStudy[]

  @@map("brands")
}

model BrandCaseStudy {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tag         String // e.g. "RELIANCE · 2024"
  title       String
  description String
  year        String?
  // Up to ~3 inline stats shown on the case-study card.
  // Shape: Array<{ value: string; label: string }>.
  stats       Json     @default("[]")
  imageId     String?
  image       Media?   @relation("BrandCaseStudyImage", fields: [imageId], references: [id], onDelete: SetNull)
  position    Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@map("brand_case_studies")
}

model Industry {
  id             String  @id @default(uuid())
  slug           String  @unique
  name           String
  description    String?
  // Storefront-facing display copy. `tagline` is the eyebrow shown
  // above the H1 on /industries/<slug>; `headline` is the H1 itself;
  // `breadcrumb` is the all-caps version used in nav crumbs.
  tagline        String?
  headline       String?
  breadcrumb     String?
  // Visual identity — gradient CSS for the dark hero band per industry.
  gradient       String?
  seoTitle       String?
  seoDescription String?
  heroId         String?
  hero           Media?  @relation(fields: [heroId], references: [id])
  isPublished    Boolean @default(false)
  position       Int     @default(0)

  // Structured marketing data. Stored as JSON because each is a small
  // array of plain objects whose shape rarely changes — keeps the
  // admin editor surface manageable while preserving the rich page
  // template. Strongly-typed at the read site via `lib/industry-content.ts`.
  chips                 Json  @default("[]") // string[]
  stats                 Json  @default("[]") // { value, label }[]
  deliveryAreas         Json  @default("[]") // { category, title, description, skuCount }[]
  supportBlock          Json? // { eyebrow, headline, description, bullets, cta }
  featuredProductSkus   Json  @default("[]") // string[]
  featuredCategorySlugs Json  @default("[]") // string[]

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean     @default(true)
  robotsFollow       Boolean     @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?    @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean     @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?

  accounts     Account[]
  navMenuItems NavMenuItem[]
  caseStudies  IndustryCaseStudy[]

  @@map("industries")
}

model IndustryCaseStudy {
  id          String   @id @default(uuid())
  industryId  String
  industry    Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  tag         String // e.g. "HPCL · 2024"
  title       String
  description String
  year        String?
  imageId     String?
  image       Media?   @relation("IndustryCaseStudyImage", fields: [imageId], references: [id], onDelete: SetNull)
  position    Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([industryId])
  @@map("industry_case_studies")
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICE CASES — case-study-led services section under /services
// Replaces the old "BOP services as products" pattern. Every case is a
// structured engineering writeup: hero (pills, title-with-accent, deck, hero
// figure, meta strip) + body (8 typed-block kinds renderered via switch) +
// sticky right rail (CTA, pull quote, specs at glance, gallery, downloads).
// Block types live in @indus/domain/src/service-case-blocks.ts (Zod-validated).
// ─────────────────────────────────────────────────────────────────────────────

model ServiceCase {
  id          String            @id @default(uuid())
  slug        String            @unique
  caseNumber  String // Display ordinal, e.g. "07" — not unique
  status      ServiceCaseStatus @default(draft)
  publishedAt DateTime?
  isFeatured  Boolean           @default(false) // Case of the Week — exactly one expected published

  // Hero
  category         ServiceCaseCategory // For chip-filter & related-cases lookup
  topicLabel       String // Display pill text, e.g. "Cylinders · Hoses · Oilfield"
  region           String? // "🇦🇪 UAE · Jebel Ali" — hero region pill (with flag)
  caseDateLabel    String? // "MAR 2026 · BAY 2 / ON-SITE" — hero meta line
  title            String
  titleAccent      String? // Optional italic-accent phrase highlighted within the title
  deck             String // Serif sub-headline paragraph
  heroImageId      String?
  heroImage        Media?              @relation("ServiceCaseHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  heroImageCaption String? // Caption under hero image
  heroImageCredit  String? // "PHOTO · K. AL MARZOUQI · 2026-03-04"

  // Meta strip — 5 customisable {label, value, valueSmall?, style?} cells.
  // Always rendered alongside a hard-coded "Quote a similar job" CTA cell.
  metaCells Json @default("[]")

  // Body blocks — array of typed BodyBlock objects (see @indus/domain).
  bodyBlocks Json @default("[]")

  // Right rail
  ctaCardTitle      String?
  ctaCardBody       String?
  ctaCardPhone      String? // Optional secondary CTA line, e.g. "+971 4 881 2345"
  pullQuoteText     String?
  pullQuoteAuthor   String?
  pullQuoteRole     String?
  pullQuoteLocation String?
  specsAtGlance     Json    @default("[]") // Array<{ label, value }>
  galleryImageIds   Json    @default("[]") // string[] — Media ids; rendered as 6-up thumb grid
  galleryTotalCount Int     @default(0) // For "View N photos →" link
  downloads         Json    @default("[]") // Array<{ label, url, size, format }>

  // Footer of article
  caseFileMeta String? // "Case file · INTAKE-... · WO-... · Published... · Updated..."

  // Index-grid card display
  cardOneLiner      String? // Short paragraph under card heading (defaults to deck if null)
  cardOutcomePills  Json                    @default("[]") // Array<{ label, style: 'good' | 'accent' | 'neutral' }>
  cardDurationLabel String? // "96 H ON BENCH" overlay on card image
  cardTagStyle      ServiceCaseCardTagStyle @default(standard)
  cardTagLabel      String // "OILFIELD" / "CYLINDERS" — display tag override (independent of category)

  // Sort/filter dimensions
  durationDays    Int? // For sort=tat (ascending)
  savingsAmount   Int? // For sort=savings (descending) — minor units, currency-typed
  savingsCurrency Currency?

  // SEO OS — same surface as Product / BlogPost
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  robotsIndex        Boolean     @default(true)
  robotsFollow       Boolean     @default(true)
  ogImageMediaId     String?
  ogImage            Media?      @relation("ServiceCaseOg", fields: [ogImageMediaId], references: [id], onDelete: SetNull)
  focusKeyword       String?
  sitemapPriority    Decimal?    @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean     @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?

  // FTS column managed by raw SQL migration (Unsupported: tsvector).
  // STORED, weighted A→B→C across title / deck / cardOneLiner.
  searchTsv Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
  @@index([isFeatured, status, publishedAt])
  @@map("service_cases")
}

model Product {
  id                String        @id @default(uuid())
  sku               String        @unique
  mpn               String?
  slug              String        @unique
  title             String
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?        @relation(fields: [brandId], references: [id])
  descriptionShort  String?
  descriptionLong   String? // markdown/rich text
  listPrice         Decimal?      @db.Decimal(12, 2)
  listPriceCurrency Currency      @default(USD)
  // Optional MSRP / "compare at" price. Renders as strike-through above
  // listPrice on the storefront when set AND strictly greater than
  // listPrice. Null → no compare display, no fake-discount UI.
  compareAtPrice    Decimal?      @db.Decimal(12, 2)
  unitOfMeasure     UnitOfMeasure @default(each)
  weightKg          Decimal?      @db.Decimal(8, 3)
  dimensionsMm      Json? // {l, w, h}
  leadTimeDays      Int?
  warrantyMonths    Int?
  stockQty          Int           @default(0) // Aggregate stock across all warehouses; 0 = out of stock / lead-time-only
  stockWarehouse    String? // Free-text warehouse identifier for the storefront pill (e.g. "Dubai")
  countryOfOrigin   String?
  hsCode            String?
  status            ProductStatus @default(draft)
  supersededById    String?
  supersededBy      Product?      @relation("Supersession", fields: [supersededById], references: [id])
  supersedes        Product[]     @relation("Supersession")
  specTemplateId    String?
  specTemplate      SpecTemplate? @relation(fields: [specTemplateId], references: [id], onDelete: SetNull)
  seoTitle          String?
  seoDescription    String?
  // Persisted content-depth score (0–100) computed by scoreProductContent.
  // Recomputed on every product mutation; indexed for admin filter/sort
  // and for the storefront PRODUCT_CONTENT_NOINDEX_BELOW threshold.
  contentScore      Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // SEO OS — inline overrides
  canonicalUrl       String?
  robotsIndex        Boolean                  @default(true)
  robotsFollow       Boolean                  @default(true)
  ogImageMediaId     String?
  focusKeyword       String?
  sitemapPriority    Decimal?                 @db.Decimal(2, 1)
  sitemapChangeFreq  ChangeFreq?
  excludeFromSitemap Boolean                  @default(false)
  jsonLdOverride     Json?
  seoUpdatedAt       DateTime?
  seoUpdatedById     String?
  // FTS column managed by raw SQL migration (Unsupported: tsvector)
  searchTsv          Unsupported("tsvector")?

  images          ProductImage[]
  specs           ProductSpec[]
  documents       ProductDocument[]
  crossReferences ProductCrossReference[]
  faqs            ProductFaq[]
  rfqLines        RfqLine[]
  savedListItems  SavedListItem[]
  orderLines      OrderLine[]
  navMenuItems    NavMenuItem[]
  blogPosts       BlogPostProduct[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id])
  position  Int     @default(0)
  alt       String?

  @@index([productId])
  @@map("product_images")
}

model ProductSpec {
  id              String             @id @default(uuid())
  productId       String
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  group           String // "Hydraulic performance", "Mechanical", "Fluids", "Commercial"
  label           String
  value           String
  unit            String?
  position        Int                @default(0)
  isFilterable    Boolean            @default(false)
  templateFieldId String?
  templateField   SpecTemplateField? @relation(fields: [templateFieldId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([templateFieldId])
  @@map("product_specs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SPEC TEMPLATES — reusable typed schemas for product specs/key features.
// A category sets a default template; products attach to one. Each field has
// flags (isKeyFeature, isQuickSpec) for which storefront render zone it drives.
// ─────────────────────────────────────────────────────────────────────────────

model SpecTemplate {
  id          String              @id @default(uuid())
  slug        String              @unique
  name        String
  description String?
  position    Int                 @default(0)
  fields      SpecTemplateField[]
  products    Product[]
  categories  Category[]          @relation("CategoryDefaultTemplate")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("spec_templates")
}

model SpecTemplateField {
  id           String        @id @default(uuid())
  templateId   String
  template     SpecTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key          String // immutable machine name once any ProductSpec references it
  label        String
  unit         String?
  dataType     SpecFieldType @default(text)
  options      Json? // for dataType=select: ["A","B","C"]
  helpText     String?
  isRequired   Boolean       @default(false)
  isKeyFeature Boolean       @default(false)
  isQuickSpec  Boolean       @default(false)
  group        String? // grouping for the tech-specs tab
  position     Int           @default(0)
  productSpecs ProductSpec[]

  @@unique([templateId, key])
  @@index([templateId])
  @@map("spec_template_fields")
}

model ProductDocument {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      DocumentKind
  title     String
  language  String       @default("en")
  mediaId   String
  media     Media        @relation(fields: [mediaId], references: [id])
  isGated   Boolean      @default(false)
  position  Int          @default(0)

  // PARTIAL UNIQUE INDEX (Postgres-only, not representable in Prisma schema):
  //   CREATE UNIQUE INDEX product_documents_one_datasheet_per_product
  //     ON product_documents ("productId") WHERE kind = 'datasheet';
  // Applied via migration `enforce_one_datasheet_per_product`.
  // Enforces "one datasheet per product" while still allowing multiple
  // STEP/IGES/manual documents. DO NOT run `prisma db push` against this
  // schema — it cannot represent the index and will silently drop it.
  @@index([productId])
  @@map("product_documents")
}

model ProductCrossReference {
  id              String                @id @default(uuid())
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorBrand String
  competitorMpn   String
  compatibility   CrossRefCompatibility @default(direct)

  @@index([productId])
  @@map("product_cross_references")
}

// Admin-curated FAQ shown on the product detail page. No customer-submission
// flow — the previous moderated Q&A model was replaced because the field was
// always intended to be a static, per-product FAQ.
model ProductFaq {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  position  Int     @default(0)

  @@index([productId])
  @@map("product_faqs")
}

model Media {
  id               String     @id @default(uuid())
  kind             MediaKind
  mimeType         String
  originalFilename String
  storagePath      String // S3/R2 key
  bytes            Int
  width            Int?
  height           Int?
  alt              String?
  caption          String?
  uploadedById     String?
  uploadedBy       StaffUser? @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime   @default(now())

  productImages           ProductImage[]
  productDocuments        ProductDocument[]
  categoryImages          Category[]
  brandLogos              Brand[]             @relation("BrandLogo")
  brandHeroes             Brand[]             @relation("BrandHero")
  brandCaseStudyImages    BrandCaseStudy[]    @relation("BrandCaseStudyImage")
  industryHeroes          Industry[]
  industryCaseStudyImages IndustryCaseStudy[] @relation("IndustryCaseStudyImage")
  rfqAttachments          RfqAttachment[]
  quotePdfs               Quote[]
  blogHeroes              BlogPost[]
  blogCategoryImages      BlogCategory[]      @relation("BlogCategoryImage")
  blogAuthorAvatars       BlogAuthor[]        @relation("BlogAuthorAvatar")
  importJobSources        ImportJob[]
  navMenuItemPromos       NavMenuItem[]       @relation("NavMenuItemPromo")
  storeSettingsLogos      StoreSettings[]     @relation("StoreSettingsLogo")
  storeSettingsFooterLogos StoreSettings[]    @relation("StoreSettingsFooterLogo")
  storeSettingsFavicons   StoreSettings[]     @relation("StoreSettingsFavicon")
  storeSettingsSearchLogos StoreSettings[]    @relation("StoreSettingsSearchLogo")
  homepageHeroSlides      HomepageHeroSlide[]
  serviceCaseHeroes       ServiceCase[]       @relation("ServiceCaseHero")
  serviceCaseOgImages     ServiceCase[]       @relation("ServiceCaseOg")

  @@map("media")
}

// ─────────────────────────────────────────────────────────────────────────────
// RFQ → QUOTE → ORDER
// ─────────────────────────────────────────────────────────────────────────────

model Rfq {
  id                    String          @id @default(uuid())
  code                  String          @unique // RFQ-2026-0418
  accountId             String
  account               Account         @relation(fields: [accountId], references: [id])
  submittedByContactId  String?
  submittedBy           AccountContact? @relation("SubmittedBy", fields: [submittedByContactId], references: [id])
  subject               String?
  applicationContext    String?
  urgency               RfqUrgency      @default(routine)
  requestedDeliveryDate DateTime?
  shipToAddressId       String?
  shipToAddress         AccountAddress? @relation("ShipToAddress", fields: [shipToAddressId], references: [id])
  billToAddressId       String?
  billToAddress         AccountAddress? @relation("BillToAddress", fields: [billToAddressId], references: [id])
  incoterm              String?
  currency              Currency        @default(USD)
  status                RfqStatus       @default(draft)
  assignedEngineerId    String?
  assignedEngineer      StaffUser?      @relation("AssignedEngineer", fields: [assignedEngineerId], references: [id])
  assignedRepId         String?
  assignedRep           StaffUser?      @relation("AssignedRep", fields: [assignedRepId], references: [id])
  internalNotes         String?
  customerMessage       String?
  // Lightweight order-tracking fields. Filled by admin once the order is
  // dispatched; surfaced under the Shipped step on the customer's
  // /quote/[code] timeline. No carrier integration — free-text strings
  // the admin pastes from the carrier's portal.
  trackingCarrier       String?
  trackingNumber        String?
  submittedAt           DateTime?
  quoteSentAt           DateTime?
  acceptedAt            DateTime?
  quoteExpiresAt        DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  lines       RfqLine[]
  attachments RfqAttachment[]
  quotes      Quote[]
  orders      Order[]
  sentEmails  SentEmail[]

  @@index([accountId, status, submittedAt])
  @@index([status])
  @@map("rfqs")
}

model RfqLine {
  id                   String   @id @default(uuid())
  rfqId                String
  rfq                  Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId            String
  product              Product  @relation(fields: [productId], references: [id])
  requestedQty         Int
  customerTargetPrice  Decimal? @db.Decimal(12, 2)
  shipFromWarehouse    String? // free-text (e.g. "Dubai", "Abu Dhabi") — no warehouse entity in scope
  engineerUnitPrice    Decimal? @db.Decimal(12, 2)
  engineerLeadTimeDays Int?
  appliedRuleIds       Json?    @default("[]") // future: pricing rule references
  engineerNotes        String?
  position             Int      @default(0)

  orderLines OrderLine[]

  @@index([rfqId])
  @@map("rfq_lines")
}

model RfqAttachment {
  id           String   @id @default(uuid())
  rfqId        String
  rfq          Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  mediaId      String
  media        Media    @relation(fields: [mediaId], references: [id])
  uploaderType String? // "contact" | "staff"
  uploaderId   String?
  createdAt    DateTime @default(now())

  @@map("rfq_attachments")
}

model Quote {
  id                String    @id @default(uuid())
  code              String    @unique // Q-2026-0418
  rfqId             String
  rfq               Rfq       @relation(fields: [rfqId], references: [id])
  revision          Int       @default(1)
  subtotal          Decimal   @db.Decimal(12, 2)
  discountTotal     Decimal   @default(0) @db.Decimal(12, 2)
  shipping          Decimal   @default(0) @db.Decimal(12, 2)
  tax               Decimal   @default(0) @db.Decimal(12, 2)
  total             Decimal   @db.Decimal(12, 2)
  currency          Currency  @default(USD)
  termsPayment      String    @default("Net 30")
  termsValidityDays Int       @default(30)
  pdfMediaId        String?
  pdfMedia          Media?    @relation(fields: [pdfMediaId], references: [id])
  sentAt            DateTime?
  expiresAt         DateTime?
  acceptedAt        DateTime?
  declinedAt        DateTime?

  orders     Order[]
  sentEmails SentEmail[]

  @@index([rfqId])
  @@map("quotes")
}

model Order {
  id               String      @id @default(uuid())
  code             String      @unique // ORD-2026-0418
  quoteId          String?
  quote            Quote?      @relation(fields: [quoteId], references: [id])
  rfqId            String?
  rfq              Rfq?        @relation(fields: [rfqId], references: [id])
  accountId        String?
  status           OrderStatus @default(pending_credit_check)
  customerPoNumber String?
  subtotal         Decimal     @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  currency         Currency    @default(USD)
  placedAt         DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?

  lines     OrderLine[]
  shipments OrderShipment[]

  @@map("orders")
}

model OrderLine {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  rfqLineId         String?
  rfqLine           RfqLine? @relation(fields: [rfqLineId], references: [id])
  qty               Int
  unitPrice         Decimal  @db.Decimal(12, 2)
  shipFromWarehouse String?
  appliedRuleIds    Json?    @default("[]")

  @@index([orderId])
  @@map("order_lines")
}

model OrderShipment {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromWarehouse  String?
  carrier        String?
  trackingNumber String?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?

  @@map("order_shipments")
}

