// ─────────────────────────────────────────────────────────────────────────────
// BULK IMPORT
// ─────────────────────────────────────────────────────────────────────────────

model ImportJob {
  id                 String       @id @default(uuid())
  code               String       @unique // IMPORT-2026-0042
  entity             ImportEntity
  sourceMediaId      String?
  sourceMedia        Media?       @relation(fields: [sourceMediaId], references: [id])
  columnMapping      Json         @default("{}") // {csv_col: indus_field}
  options            Json         @default("{}") // {skip_errors, publish_new, ...}
  status             ImportStatus @default(uploaded)
  totalRows          Int          @default(0)
  rowsToCreate       Int          @default(0)
  rowsToUpdate       Int          @default(0)
  rowsWithWarnings   Int          @default(0)
  rowsWithErrors     Int          @default(0)
  rollbackSnapshotId String?
  startedById        String?
  startedBy          StaffUser?   @relation(fields: [startedById], references: [id])
