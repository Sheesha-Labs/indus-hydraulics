# Required for catalogue:generate and catalogue:images scripts.
# Copy to .env (in the repo root) and fill in real values.

# Database — same connection string used by Prisma everywhere else.
DATABASE_URL="postgresql://postgres:password@localhost:5432/indus_hydraulics"

# Supabase Storage — the catalogue:images script uploads PNGs to the public
# `product-images` bucket using the service-role key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Anthropic — used by catalogue:generate (Claude Sonnet) to fill catalogue rows.
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI — used by catalogue:images (gpt-image-1) to render product images.
OPENAI_API_KEY="sk-..."
