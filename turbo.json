{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "tsconfig.base.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml"
  ],
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "AUTH_SECRET",
    "CUSTOMER_AUTH_SECRET",
    "STAFF_AUTH_SECRET",
    "AUTH_TRUST_HOST",
    "NEXTAUTH_URL",
    "NEXT_PUBLIC_BASE_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "OPENAI_API_KEY",
    "OPENAI_BLUEPRINT_ORCHESTRATOR_MODEL",
    "OPENAI_BLUEPRINT_IMAGE_MODEL",
    "OPENAI_BLUEPRINT_REFERENCE_URL",
    "ANTHROPIC_API_KEY",
    "SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "NODE_ENV",

    "OPENAI_BLUEPRINT_PROMPT_MODEL",
    "PREVIEW_TOKEN_SECRET",
    "QUOTE_TOKEN_SECRET",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "PRODUCT_CONTENT_NOINDEX_BELOW",
    "SUPABASE_URL",
    "DATABASE_CONNECTION_LIMIT",
    "MICROSOFT_CLIENT_ID",
    "MICROSOFT_CLIENT_SECRET",
    "MICROSOFT_TENANT_ID",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "R2_PUBLIC_URL",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "NEXT_PUBLIC_R2_PUBLIC_URL",
    "NEXT_PUBLIC_SOCIAL_PROFILES",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "NEXT_PUBLIC_GSC_VERIFICATION",
    "NEXT_PUBLIC_BING_VERIFICATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
