# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/indus_hydraulics"

# NextAuth (storefront — account_contact sessions)
STOREFRONT_AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# NextAuth (admin — staff_user sessions)
ADMIN_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Microsoft 365 SSO (storefront)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Cloudflare R2 / S3-compatible object storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="indus-hydraulics"
R2_PUBLIC_URL="https://assets.indushydraulics.com"

# Resend (transactional email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@indushydraulics.com"

# App URLs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Social profiles surfaced as `sameAs` on the Organization JSON-LD. Comma-
# separated absolute URLs. Empty / unset = no sameAs emitted. Adding profiles
# here strengthens the entity graph that AI Overviews and Knowledge Panels
# build for the business.
NEXT_PUBLIC_SOCIAL_PROFILES="https://www.linkedin.com/company/102904342/"

# Optional content-depth noindex threshold. When set to a number 0–100,
# storefront PDPs scoring below that value emit `<meta name="robots"
# content="noindex,follow">` so Google doesn't waste crawl budget on
# stub pages while the catalogue team enriches them. Unset / 0 / non-
# numeric = enforcement disabled (safe default). Recommended ramp:
# leave OFF until ~80% of products score ≥ 50, then flip to 40.
PRODUCT_CONTENT_NOINDEX_BELOW=""

# Preview links — admin signs short-lived tokens, storefront verifies them.
# Must be identical in both apps. Generate with: openssl rand -base64 32
PREVIEW_TOKEN_SECRET="generate-with-openssl-rand-base64-32"

# Sentry — server-side error tracking. Each app needs its own DSN. See
# SENTRY_SETUP.md for the full setup walkthrough. Without these set, the
# Sentry SDK initialises but does not send events (safe local-dev default).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Sentry — build-time source-map upload. Only needed in CI / Vercel.
# Get SENTRY_AUTH_TOKEN from Sentry → User → Auth Tokens (scope: project:write).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Inngest — background jobs and scheduled functions (admin only). See
# INNGEST_SETUP.md for the full walkthrough. Without these set, the SDK
# initialises but cron functions don't fire (safe local-dev default).
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# OpenAI — product blueprint generation in the admin product editor.
# The default workflow uses GPT-5.5 to orchestrate the image-generation tool
# with GPT Image 2. Keep this key server-side; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_BLUEPRINT_ORCHESTRATOR_MODEL="gpt-5.5"
OPENAI_BLUEPRINT_IMAGE_MODEL="gpt-image-2"
# Optional override. Defaults to the approved INDUS reference stored in the
# public Supabase product-images bucket.
OPENAI_BLUEPRINT_REFERENCE_URL=""

# PostHog — product analytics + funnel events on the storefront.
# Create a project at https://app.posthog.com and grab the Project API
# key. The storefront fires: pdp_view, rfq_submitted, search_performed,
# search_zero_results, plus PostHog autocapture on every link click.
# Without NEXT_PUBLIC_POSTHOG_KEY set, the SDK never loads (no network
# requests, no cookies) — safe local-dev / preview default.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Google Analytics 4 — primary purpose is Search Console attribution of
# organic traffic. Provision a GA4 property in https://analytics.google.com,
# copy the Measurement ID (format: G-XXXXXXXXXX) and set it here. Without
# this var the GA script is not loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console — site verification token. After adding the
# property in https://search.google.com/search-console, pick the HTML-tag
# verification method and paste the value from the meta tag content
# attribute (NOT the full tag). Without this var the meta tag is omitted.
NEXT_PUBLIC_GSC_VERIFICATION=""

# Bing Webmaster Tools — site verification token. Same shape as the
# Google one; paste only the value from the meta-tag content attribute.
# Without this var the meta tag is omitted.
NEXT_PUBLIC_BING_VERIFICATION=""
