# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/indus_hydraulics"

# NextAuth (storefront — account_contact sessions)
STOREFRONT_AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# NextAuth (admin — staff_user sessions)
ADMIN_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Microsoft 365 SSO (storefront)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Cloudflare R2 / S3-compatible object storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="indus-hydraulics"
R2_PUBLIC_URL="https://assets.indushydraulics.com"

# Resend (transactional email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@indushydraulics.com"

# App URLs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Social profiles surfaced as `sameAs` on the Organization JSON-LD. Comma-
# separated absolute URLs. Empty / unset = no sameAs emitted. Adding profiles
# here strengthens the entity graph that AI Overviews and Knowledge Panels
# build for the business.
NEXT_PUBLIC_SOCIAL_PROFILES="https://www.linkedin.com/company/102904342/"

# Preview links — admin signs short-lived tokens, storefront verifies them.
# Must be identical in both apps. Generate with: openssl rand -base64 32
PREVIEW_TOKEN_SECRET="generate-with-openssl-rand-base64-32"

# Sentry — server-side error tracking. Each app needs its own DSN. See
# SENTRY_SETUP.md for the full setup walkthrough. Without these set, the
# Sentry SDK initialises but does not send events (safe local-dev default).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Sentry — build-time source-map upload. Only needed in CI / Vercel.
# Get SENTRY_AUTH_TOKEN from Sentry → User → Auth Tokens (scope: project:write).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Inngest — background jobs and scheduled functions (admin only). See
# INNGEST_SETUP.md for the full walkthrough. Without these set, the SDK
# initialises but cron functions don't fire (safe local-dev default).
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
