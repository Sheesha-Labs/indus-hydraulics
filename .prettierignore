# Read by `bun fmt`. Formatting covers code and config: TypeScript, JavaScript,
# CSS, YAML and config JSON.
#
# Prose and data are not reformatted:
#   - Markdown: docs, plans and import notes.
#   - Catalogue payloads under packages/db/data/, and the generated one-off
#     import scripts under packages/db/src/imports/ (diagram-roundtrip.test.ts
#     reads their SVG strings in the quoting the generator wrote).
#   - docs/ (including its HTML article drafts) and the design handoff, which
#     is a reference copy, not our code.
*.md
**/*.md
packages/db/data/
packages/db/src/imports/
design_handoff_indus_hydraulics_v2/
docs/
bun.lock
**/*.snap
# Written by `next dev` / `next build` and git-ignored; bun fmt reads only this
# file and the root .gitignore, not apps/*/.gitignore.
**/next-env.d.ts
# The handoff tokens.json (kept byte for byte) and the files generated from it by packages/ops-ui/scripts/gen-tokens.ts; tokens.drift.test.ts compares them
# byte for byte with the generator's output, so the formatter must not touch them.
packages/ops-ui/tokens/tokens.json
packages/ops-ui/src/styles/tokens.css
packages/ops-ui/src/styles/theme.css
packages/ops-ui/src/tokens.pdf.ts
packages/ops-ui/src/tokens.generated.ts
