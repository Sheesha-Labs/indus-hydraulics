  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        "**/*.cts"
      ],
      "rules": {
        "eslint/no-var": "error",
        "eslint/prefer-const": "error",
        "eslint/prefer-rest-params": "error",
        "eslint/prefer-spread": "error"
      }
    },
    {
      "files": [
        "apps/web/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "next-auth/react",
                "message": "Use the server actions (adminSignInAction / adminSignOutAction) \u2014 next-auth/react resolves to /api/auth, and the only Auth.js instance lives at /admin/api/auth."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/app/(storefront)/**",
        "apps/web/src/components/*.tsx",
        "apps/web/src/actions/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/lib/admin-auth",
                  "**/lib/staff-session",
                  "**/lib/rbac"
                ],
                "message": "Storefront code has no session \u2014 lib/admin-auth, lib/staff-session and lib/rbac belong to the STAFF Auth.js instance."
              }
            ],
            "paths": [
              {
                "name": "next-auth/react",
                "message": "Use the admin server actions \u2014 next-auth/react resolves to /api/auth, which does not exist."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/cache/**/*.js"
      ],
      "rules": {
        "typescript/no-require-imports": "off"
      }
    },
    {
      "files": [
        "**/*.cjs"
      ],
      "rules": {
        "typescript/no-require-imports": "off"
      }
    },
    {
      "files": [
        "packages/db/src/imports/**",
        "packages/db/data/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "warn",
        "eslint/prefer-const": "warn"
      }
    },
    {
      "files": [
        "apps/**",
        "packages/**"
      ],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          {
            "name": "Bun",
            "message": "The app runs on Node (Vercel). Bun's types are loaded only so tests type-check; the Bun global does not exist at runtime."
          }
        ]
      }
    }
  ]
