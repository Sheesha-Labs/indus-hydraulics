{
  "name": "@indus/ops",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "bun run --cwd ../../packages/ops-db db:generate && next build",
    "start": "next start --port 3100",
    "typecheck": "bun check --no-script",
    "test": "bun test --parallel --isolate=modules --randomize",
    "test:e2e": "playwright test --project=ops-e2e --project=ops-e2e-auth",
    "test:visual": "playwright test --project=ops-visual",
    "test:visual:design": "playwright test --project=ops-visual-design",
    "eval": "bun --preload ./evals/preload.ts evals/run.ts"
  },
  "dependencies": {
    "@googleapis/gmail": "22.0.2",
    "@indus/intake": "workspace:^",
    "@indus/ops-ai": "workspace:^",
    "@indus/ops-core": "workspace:^",
    "@indus/ops-db": "workspace:^",
    "@indus/ops-ui": "workspace:^",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/supabase-js": "^2.105.1",
    "@zxcvbn-ts/core": "~4.2.0",
    "@zxcvbn-ts/language-common": "~4.1.3",
    "exceljs": "4.4.0",
    "file-type": "20.5.0",
    "google-auth-library": "11.3.4",
    "html-to-text": "9.0.5",
    "inngest": "^3.54.2",
    "lucide-react": "^1.14.0",
    "mammoth": "1.9.1",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "10.4.0",
    "otplib": "^13.6.0",
    "papaparse": "5.5.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "~6.37.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "ua-parser-js": "~1.0.41",
