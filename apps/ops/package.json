    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.3.16",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/yauzl": "2.10.3",
    "jsdom": "^25",
    "jszip": "3.10.1",
