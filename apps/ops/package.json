{
  "name": "@indus/ops",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "bun run --cwd ../../packages/ops-db db:generate && next build",
    "start": "next start --port 3100",
    "typecheck": "bun check --no-script",
    "test": "bun test --parallel --isolate=modules --randomize",
    "test:e2e": "playwright test --project=ops-e2e",
    "test:visual": "playwright test --project=ops-visual",
    "test:visual:design": "playwright test --project=ops-visual-design"
  },
  "dependencies": {
    "@indus/intake": "workspace:^",
    "@indus/ops-core": "workspace:^",
    "@indus/ops-db": "workspace:^",
    "@indus/ops-ui": "workspace:^",
    "@sentry/nextjs": "^10.51.0",
    "inngest": "^3.54.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4"
  }
}
