# Indus Operations — every variable src/lib/env.ts reads. Placeholders only; real values live in Vercel
# (project indus-operations) and in your local .env.local, never in the repository.

# Database (ops_app through the transaction pooler; DIRECT_URL for scripts only)
DATABASE_URL=postgresql://ops_app:<password>@localhost:54329/postgres?schema=ops&connection_limit=1
DIRECT_URL=postgresql://ops_app:<password>@localhost:54329/postgres?schema=ops
OPS_MAINT_DATABASE_URL=

APP_ENV=local
NEXT_PUBLIC_OPS_BASE_URL=http://localhost:3100
OPS_AUTH_SECRET=<openssl rand -base64 33>
AUTH_TRUST_HOST=

# Google: one Web OAuth client for sign-in and mailbox connect (docs/gmail-setup.md)
GOOGLE_OPS_CLIENT_ID=
GOOGLE_OPS_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=example.test
GMAIL_PUBSUB_TOPIC=projects/<project>/topics/gmail-push
GMAIL_PUSH_AUDIENCE=http://localhost:3100/api/gmail/push
GMAIL_PUSH_SA_EMAIL=gmail-push-invoker@<project>.iam.gserviceaccount.com

# Encryption of stored tokens (JSON map of key id → base64 of 32 bytes) and the OAuth state HMAC
OPS_TOKEN_KEYS={"k1":"<openssl rand -base64 32>"}
OPS_TOKEN_KEY_ACTIVE=k1
OPS_STATE_SECRET=<openssl rand -base64 32>

# Inngest app indus-operations
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# System mail (Resend) and storage (Supabase)
RESEND_OPS_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SENTRY_DSN=

# Outside production only (env.ts refuses these in production)
OPS_SEND_ALLOWLIST=you@example.test
OPS_TEST_RECIPIENTS=you@example.test
OPS_E2E_AUTH=
OPS_KIT=
OPS_E2E_MAIL_SINK=
OPS_E2E_GOOGLE_ISSUER=
OPS_SESSION_REVOCATION_TTL_MS=
OPS_READ_ONLY=
