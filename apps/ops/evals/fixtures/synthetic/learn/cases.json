  {
    "id": "supplier-excluded",
    "actionKey": "pick_suppliers",
    "scope": "counterparty",
    "summary": "Rejected: Wrong supplier",
    "signals": [
      {
        "id": "r1",
        "kind": "reject",
        "detail": "{\"chip\":\"Wrong supplier\",\"reason\":\"Example Valve Co does not make bearings\"}"
      },
      {
        "id": "r2",
        "kind": "reject",
        "detail": "{\"chip\":\"Wrong supplier\",\"reason\":\"not a bearing house\"}"
      },
      {
        "id": "r3",
        "kind": "reject",
        "detail": "{\"chip\":\"Wrong supplier\",\"reason\":\"Example Valve Co again for bearings\"}"
      }
    ],
    "expect": {
      "kind": "supplier_exclusion",
      "scope": ["client", "supplier", "trade", "global"],
      "contains": ["Example Valve Co"]
    }
  },
  {
    "id": "refile-supplier",
    "actionKey": "classify_mail",
    "scope": "mailbox",
    "summary": "Changed classification to supplier_quote",
    "signals": [
      {
        "id": "o1",
        "kind": "override",
        "detail": "{\"field\":\"classification\",\"before\":\"client_enquiry\",\"after\":\"supplier_quote\",\"from\":\"sales@example-valve.test\"}"
      },
      {
        "id": "o2",
        "kind": "override",
        "detail": "{\"field\":\"classification\",\"before\":\"client_enquiry\",\"after\":\"supplier_quote\",\"from\":\"quotes@example-valve.test\"}"
      },
      {
        "id": "o3",
        "kind": "override",
        "detail": "{\"field\":\"classification\",\"before\":\"other\",\"after\":\"supplier_quote\",\"from\":\"sales@example-valve.test\"}"
      }
    ],
    "expect": {
      "kind": "classification_rule",
      "scope": "mailbox",
      "contains": ["example-valve.test"]
    }
  },
