[
  {
    "id": "salutation-client",
    "actionKey": "ack_email",
    "scope": "counterparty",
    "summary": "Salutation changed to \"Dear Mr Example,\"",
    "signals": [
      {
        "id": "s1",
        "kind": "edit",
        "detail": "{\"changes\":[{\"field\":\"body\",\"before\":\"Dear Sir,\",\"after\":\"Dear Mr Example,\"}]}"
      },
      {
        "id": "s2",
        "kind": "edit",
        "detail": "{\"changes\":[{\"field\":\"body\",\"before\":\"Dear Sir,\",\"after\":\"Dear Mr Example,\"}]}"
      },
      {
        "id": "s3",
        "kind": "edit",
        "detail": "{\"changes\":[{\"field\":\"body\",\"before\":\"Hello,\",\"after\":\"Dear Mr Example,\"}]}"
      }
    ],
    "expect": { "kind": "salutation", "scope": "client", "contains": ["Mr Example"] }
  },
